\par }{\pard\plain \ql \tx115\li115\ri130\sb80\widctlpar\aspalpha\aspnum\faauto\adjustright\rin130\txn115\lin115\itap0 \f1\fs16\lang1033\langfe1033\cgrid\langnp1033\langfenp1033\insrsid11405926 \{bmc windows console - nt mbox plugin - 256c.bmp\}}{\insrsid11405926  }{\insrsid7218531\charrsid5121317 
\par }{\insrsid7218531 You can configure the NT Mailbox Plugin to automatically create mailboxes for members of a NT Group.  This configuration can be set differently for each virtual domain.
\par }\pard\plain \s4\ql \tx115\li115\ri130\sb80\widctlpar\aspalpha\aspnum\faauto\outlinelevel3\adjustright\rin130\txn115\lin115\itap0 \b\f2\fs16\ul\lang1033\langfe1033\cgrid\langnp1033\langfenp1033 {\insrsid7218531 Automatically Create NT Mailboxes
\par }\pard\plain \ql \tx115\li115\ri130\sb80\widctlpar\aspalpha\aspnum\faauto\adjustright\rin130\txn115\lin115\itap0 \f1\fs16\lang1033\langfe1033\cgrid\langnp1033\langfenp1033 {\insrsid7218531 When a user tries to log on using POP or IMAP, or when a new message arrives for the mailbox, the logon attempt or delivery will normally fail if that mailbox does not exist.  If you enable mailbox auto-creation for the selected NT group, then provided the user is listed in the group, the mailbox will be created automatically and the logon attempt or delivery will succeed. You can enable automatic mailbox creation for each domain individually.
\par }\pard\plain \s4\ql \tx115\li115\ri130\sb80\widctlpar\aspalpha\aspnum\faauto\outlinelevel3\adjustright\rin130\txn115\lin115\itap0 \b\f2\fs16\ul\lang1033\langfe1033\cgrid\langnp1033\langfenp1033 {\insrsid7218531 NT Group
\par }\pard\plain \ql \tx115\li115\ri130\sb80\widctlpar\aspalpha\aspnum\faauto\adjustright\rin130\txn115\lin115\itap0 \f1\fs16\lang1033\langfe1033\cgrid\langnp1033\langfenp1033 {\insrsid7218531 Select one of the NT Groups that you wish to use.  Local Groups are listed with a computer icon.  Domain Groups are listed with a server icon.
\par }\pard\plain \s2\ql \tx115\li115\ri130\sb120\sa40\keepn\widctlpar\aspalpha\aspnum\faauto\outlinelevel1\adjustright\rin130\txn115\lin115\itap0\pararsid8130183 \b\f1\fs28\cf17\lang1033\langfe1033\cgrid\langnp1033\langfenp1033 {\insrsid7218531 \page }{\cs98\super\insrsid7218531 #{\footnote \pard\plain \s97\ql \tx115\li115\ri130\sb80\widctlpar\aspalpha\aspnum\faauto\adjustright\rin130\txn115\lin115\itap0 \f1\fs16\lang1033\langfe1033\cgrid\langnp1033\langfenp1033 {\cs98\super\insrsid15606814 #}{\insrsid15606814  MailListPluginsFolder}}${\footnote \pard\plain \s97\ql \tx115\li115\ri130\sb80\widctlpar\aspalpha\aspnum\faauto\adjustright\rin130\txn115\lin115\itap0 \f1\fs16\lang1033\langfe1033\cgrid\langnp1033\langfenp1033 {\cs98\super\insrsid15606814 $}{\insrsid15606814  Mail List Plugins}}K{\footnote \pard\plain \s97\ql \tx115\li115\ri130\sb80\widctlpar\aspalpha\aspnum\faauto\adjustright\rin130\txn115\lin115\itap0 \f1\fs16\lang1033\langfe1033\cgrid\langnp1033\langfenp1033 {\cs98\super\insrsid15606814 K}{\insrsid15606814  Mail List Plugins}}+{\footnote \pard\plain \s97\ql \tx115\li115\ri130\sb80\widctlpar\aspalpha\aspnum\faauto\adjustright\rin130\txn115\lin115\itap0 \f1\fs16\lang1033\langfe1033\cgrid\langnp1033\langfenp1033 {\cs98\super\insrsid15606814 +}{\insrsid15606814  mailsite:0000}}}{\insrsid7218531  Mail List Plugins
\par }\pard\plain \ql \tx115\li115\ri130\sb80\widctlpar\aspalpha\aspnum\faauto\adjustright\rin130\txn115\lin115\itap0 \f1\fs16\lang1033\langfe1033\cgrid\langnp1033\langfenp1033 {\cs98\super\insrsid7218531 K{\footnote \pard\plain \s97\ql \tx115\li115\ri130\sb80\widctlpar\aspalpha\aspnum\faauto\adjustright\rin130\txn115\lin115\itap0 \f1\fs16\lang1033\langfe1033\cgrid\langnp1033\langfenp1033 {\cs98\super\insrsid15606814 K}{\insrsid15606814  Mail List Plugins}}}{\insrsid7218531 Click on the Mail List Plugins folder to view the available mail list plugins on the target server.
\par }{\pard\plain \ql \tx115\li115\ri130\sb80\widctlpar\aspalpha\aspnum\faauto\adjustright\rin130\txn115\lin115\itap0 \f1\fs16\lang1033\langfe1033\cgrid\langnp1033\langfenp1033\insrsid5121317 \{bmc windows console - maillist plugin - 256c.bmp\}}{\insrsid5121317  }{\insrsid7218531\charrsid5121317 
\par }{\insrsid7218531 Each mail list type is implemented by a Mail List Plugin.   }{\insrsid13722995 WorldMail}{\insrsid7218531  ships with five Mail List Plugins: }{\b\f2\insrsid7218531 Registry}{\insrsid7218531 , }{\b\f2\insrsid7218531 NT}{\insrsid7218531 , }{\b\f2\insrsid7218531 Text File}{\insrsid7218531 , }{\b\f2\insrsid7218531 Database}{\insrsid7218531 , and }{\b\f2\insrsid7218531 Server}{\insrsid7218531 .  Note that none of the Mail List Plugins have any configuration options.
\par }\pard\plain \s2\ql \tx115\li115\ri130\sb120\sa40\keepn\widctlpar\aspalpha\aspnum\faauto\outlinelevel1\adjustright\rin130\txn115\lin115\itap0\pararsid8130183 \b\f1\fs28\cf17\lang1033\langfe1033\cgrid\langnp1033\langfenp1033 {\insrsid7218531 \page }{\cs98\super\insrsid7218531 #{\footnote \pard\plain \s97\ql \tx115\li115\ri130\sb80\widctlpar\aspalpha\aspnum\faauto\adjustright\rin130\txn115\lin115\itap0 \f1\fs16\lang1033\langfe1033\cgrid\langnp1033\langfenp1033 {\cs98\super\insrsid15606814 #}{\insrsid15606814  DomainsFolder}}${\footnote \pard\plain \s97\ql \tx115\li115\ri130\sb80\widctlpar\aspalpha\aspnum\faauto\adjustright\rin130\txn115\lin115\itap0 \f1\fs16\lang1033\langfe1033\cgrid\langnp1033\langfenp1033 {\cs98\super\insrsid15606814 $}{\insrsid15606814  Domains Folder}}K{\footnote \pard\plain \s97\ql \tx115\li115\ri130\sb80\widctlpar\aspalpha\aspnum\faauto\adjustright\rin130\txn115\lin115\itap0 \f1\fs16\lang1033\langfe1033\cgrid\langnp1033\langfenp1033 {\cs98\super\insrsid15606814 K}{\insrsid15606814  Domains Folder}}+{\footnote \pard\plain \s97\ql \tx115\li115\ri130\sb80\widctlpar\aspalpha\aspnum\faauto\adjustright\rin130\txn115\lin115\itap0 \f1\fs16\lang1033\langfe1033\cgrid\langnp1033\langfenp1033 {\cs98\super\insrsid15606814 +}{\insrsid15606814  mailsite:0000}}}{\insrsid7218531  Domains
\par }\pard\plain \ql \tx115\li115\ri130\sb80\widctlpar\aspalpha\aspnum\faauto\adjustright\rin130\txn115\lin115\itap0 \f1\fs16\lang1033\langfe1033\cgrid\langnp1033\langfenp1033 {\cs98\super\insrsid7218531 K{\footnote \pard\plain \s97\ql \tx115\li115\ri130\sb80\widctlpar\aspalpha\aspnum\faauto\adjustright\rin130\txn115\lin115\itap0 \f1\fs16\lang1033\langfe1033\cgrid\langnp1033\langfenp1033 {\cs98\super\insrsid15606814 K}{\insrsid15606814  Domains}}}{\insrsid7218531 The }{\insrsid14683656 Management Center}{\insrsid7218531  contains a Domains Folder that expands to show a list of the mail domains that are managed by the }{\insrsid14683656 Management Center}{\insrsid7218531 .  Each domain is represented by a folder, which itself contains folders for the mailboxes and mail lists belonging to that domain, and icons representing properties and options for the domain itself.
\par }{\pard\plain \ql \tx115\li115\ri130\sb80\widctlpar\aspalpha\aspnum\faauto\adjustright\rin130\txn115\lin115\itap0 \f1\fs16\lang1024\langfe1024\cgrid\noproof\langnp1033\langfenp1033\insrsid5121317 \{bmc windows console - domains - 256c.bmp\}}{\lang1024\langfe1024\noproof\insrsid5121317  }{\insrsid7218531\charrsid5121317 
\par }\pard\plain \s4\ql \tx115\li115\ri130\sb80\widctlpar\aspalpha\aspnum\faauto\outlinelevel3\adjustright\rin130\txn115\lin115\itap0 \b\f2\fs16\ul\lang1033\langfe1033\cgrid\langnp1033\langfenp1033 {\insrsid7218531 Default Domain
\par }\pard\plain \ql \tx115\li115\ri130\sb80\widctlpar\aspalpha\aspnum\faauto\adjustright\rin130\txn115\lin115\itap0 \f1\fs16\lang1033\langfe1033\cgrid\langnp1033\langfenp1033 {\cs98\super\insrsid7218531 K{\footnote \pard\plain \s97\ql \tx115\li115\ri130\sb80\widctlpar\aspalpha\aspnum\faauto\adjustright\rin130\txn115\lin115\itap0 \f1\fs16\lang1033\langfe1033\cgrid\langnp1033\langfenp1033 {\cs98\super\insrsid15606814 K}{\insrsid15606814  Domains,Default}}}{\insrsid7218531 The default domain can be identified by the gray folder icon.  This is the "home" domain for this server.  }{\insrsid13722995 WorldMail}{\insrsid7218531  reads the name of the default domain from the }{\b\f2\insrsid7218531 HOST}{\insrsid7218531  and }{\b\f2\insrsid7218531 DOMAIN}{\insrsid7218531  fields in your TCP/IP: DNS configuration. 
\par The default domain always exists--you cannot delete it.  However, the default domain name can be changed.  For example, if }{\insrsid13722995 WorldMail}{\insrsid7218531  was installed with the default domain }{\b\f2\insrsid7218531 mail.mycompany.com}{\insrsid7218531  , you can change this to be }{\b\f2\insrsid7218531 mycompany.com}{\insrsid7218531 .
\par }\pard\plain \s4\ql \tx115\li115\ri130\sb80\widctlpar\aspalpha\aspnum\faauto\outlinelevel3\adjustright\rin130\txn115\lin115\itap0 \b\f2\fs16\ul\lang1033\langfe1033\cgrid\langnp1033\langfenp1033 {\insrsid7218531 Rename Default Domain
\par }\pard\plain \ql \tx115\li115\ri130\sb80\widctlpar\aspalpha\aspnum\faauto\adjustright\rin130\txn115\lin115\itap0 \f1\fs16\lang1033\langfe1033\cgrid\langnp1033\langfenp1033 {\insrsid7218531 To rename the default domain, select the domain, then click on the domain name. Or, select the domain and select }{\b\f2\insrsid7218531 Rename}{\insrsid7218531  from the right-button pop-up menu.
\par If you rename the default domain, it is your responsibility to ensure that the new domain name has an appropriate MX record in the DNS, so that mail addressed to }{\b\f2\insrsid7218531 user@mucompany.com}{\insrsid7218531  gets routed to the mail server at }{\b\f2\insrsid7218531 mail.mycompany.com}{\insrsid7218531 .
\par You can only rename the default domain.  To rename other domains, create a new domain, move the users and mailing lists from the old domain into the new one, then delete the old domain.
\par }\pard\plain \s4\ql \tx115\li115\ri130\sb80\widctlpar\aspalpha\aspnum\faauto\outlinelevel3\adjustright\rin130\txn115\lin115\itap0 \b\f2\fs16\ul\lang1033\langfe1033\cgrid\langnp1033\langfenp1033 {\insrsid7218531 New Domain
\par }\pard\plain \ql \tx115\li115\ri130\sb80\widctlpar\aspalpha\aspnum\faauto\adjustright\rin130\txn115\lin115\itap0 \f1\fs16\lang1033\langfe1033\cgrid\langnp1033\langfenp1033 {\insrsid7218531 Select the Domains Folder or one of the existing virtual domain folders.  Then choose the }{\b\f2\insrsid7218531 New}{\insrsid7218531  option from the Domain menu (or click the corresponding toolbar button, or right-click on the folder and select }{\b\f2\insrsid7218531 New}{\insrsid7218531  from the popup menu).  A new domain folder will appear, and you should give it a unique name.  It is your responsibility to register the domain in the DNS.
\par }\pard\plain \s4\ql \tx115\li115\ri130\sb80\widctlpar\aspalpha\aspnum\faauto\outlinelevel3\adjustright\rin130\txn115\lin115\itap0 \b\f2\fs16\ul\lang1033\langfe1033\cgrid\langnp1033\langfenp1033 {\insrsid7218531 Delete Domain
\par }\pard\plain \ql \tx115\li115\ri130\sb80\widctlpar\aspalpha\aspnum\faauto\adjustright\rin130\txn115\lin115\itap0 \f1\fs16\lang1033\langfe1033\cgrid\langnp1033\langfenp1033 {\insrsid7218531 To delete a domain, select the domain(s) you wish to delete, then either select }{\b\f2\insrsid7218531 Delete}{\insrsid7218531  from the right-button pop-up menu, or click the }{\b\f2\insrsid7218531 Delete}{\insrsid7218531  button. You cannot delete a domain if it still contains mailboxes or mail lists.
\par }\pard\plain \s4\ql \tx115\li115\ri130\sb80\widctlpar\aspalpha\aspnum\faauto\outlinelevel3\adjustright\rin130\txn115\lin115\itap0 \b\f2\fs16\ul\lang1033\langfe1033\cgrid\langnp1033\langfenp1033 {\insrsid7218531 Domain Properties
\par }\pard\plain \ql \tx115\li115\ri130\sb80\widctlpar\aspalpha\aspnum\faauto\adjustright\rin130\txn115\lin115\itap0 \f1\fs16\lang1033\langfe1033\cgrid\langnp1033\langfenp1033 {\insrsid7218531 To change the properties of a domain, double-click on its Domain Properties icon, or select the domain and choose }{\b\f2\insrsid7218531 Properties}{\insrsid7218531  from the right-button pop-up menu. The resulting dialog lets you associate an IP address with the domain and control whether you want non-delivery messages from this domain to be copied to the postmaster. Note that it is not possible to associate the default domain with an IP address.
\par }\pard\plain \s4\ql \tx115\li115\ri130\sb80\widctlpar\aspalpha\aspnum\faauto\outlinelevel3\adjustright\rin130\txn115\lin115\itap0 \b\f2\fs16\ul\lang1033\langfe1033\cgrid\langnp1033\langfenp1033 {\insrsid7218531 Sieve Filter
\par }\pard\plain \ql \tx115\li115\ri130\sb80\widctlpar\aspalpha\aspnum\faauto\adjustright\rin130\txn115\lin115\itap0 \f1\fs16\lang1033\langfe1033\cgrid\langnp1033\langfenp1033 {\insrsid7218531 To set domain-level mail filters, double-click on the }{\b\f2\insrsid7218531 Sieve Filter}{\insrsid7218531  icon. This displays the Sieve filter rules associated with the domain and allows you to create, modify, and delete filter rules. Domain-level filter rules are applied only to messages sent to or from mailboxes in this domain.
\par }\pard\plain \s4\ql \tx115\li115\ri130\sb80\widctlpar\aspalpha\aspnum\faauto\outlinelevel3\adjustright\rin130\txn115\lin115\itap0 \b\f2\fs16\ul\lang1033\langfe1033\cgrid\langnp1033\langfenp1033 {\insrsid7218531 Kaspersky Anti-Virus Filter
\par }\pard\plain \ql \tx115\li115\ri130\sb80\widctlpar\aspalpha\aspnum\faauto\adjustright\rin130\txn115\lin115\itap0 \f1\fs16\lang1033\langfe1033\cgrid\langnp1033\langfenp1033 {\insrsid7218531 To set virus scanning policies for a domain, double-click on the }{\b\f2\insrsid7218531 Kaspersky Anti-Virus Filter}{\insrsid7218531  icon. For each domain, you can specify that all messages sent to or from the domain will be scanned for viruses, or only messages that are addressed to mailboxes that have the virus scanning option enabled.
\par }\pard\plain \s4\ql \tx115\li115\ri130\sb80\widctlpar\aspalpha\aspnum\faauto\outlinelevel3\adjustright\rin130\txn115\lin115\itap0 \b\f2\fs16\ul\lang1033\langfe1033\cgrid\langnp1033\langfenp1033 {\insrsid7218531 Banner Insertion
\par }\pard\plain \ql \tx115\li115\ri130\sb80\widctlpar\aspalpha\aspnum\faauto\adjustright\rin130\txn115\lin115\itap0 \f1\fs16\lang1033\langfe1033\cgrid\langnp1033\langfenp1033 {\insrsid7218531 To set custom message banners for a domain, double-click on the }{\b\f2\insrsid7218531 Banner Insertion}{\insrsid7218531  icon. For each domain, you can specify a header and/or footer to be added to the contents of each message sent by users within that domain.
\par }\pard\plain \s4\ql \tx115\li115\ri130\sb80\widctlpar\aspalpha\aspnum\faauto\outlinelevel3\adjustright\rin130\txn115\lin115\itap0 \b\f2\fs16\ul\lang1033\langfe1033\cgrid\langnp1033\langfenp1033 {\insrsid7218531 Virtual Domains
\par }\pard\plain \ql \tx115\li115\ri130\sb80\widctlpar\aspalpha\aspnum\faauto\adjustright\rin130\txn115\lin115\itap0 \f1\fs16\lang1033\langfe1033\cgrid\langnp1033\langfenp1033 {\cs98\super\insrsid7218531 K{\footnote \pard\plain \s97\ql \tx115\li115\ri130\sb80\widctlpar\aspalpha\aspnum\faauto\adjustright\rin130\txn115\lin115\itap0 \f1\fs16\lang1033\langfe1033\cgrid\langnp1033\langfenp1033 {\cs98\super\insrsid15606814 K}{\insrsid15606814  Domains,Virtual}}}{\insrsid7218531 You can receive mail addressed to multiple domains on a single server.  To do this, create a new entry for each under the Domains Folder.  With virtual domains, mailboxes and mail lists can be managed on a per-domain basis, and each domain may have its own postmaster.
\par For example, if you add a virtual domain }{\b\f2\insrsid7218531 xyz.com}{\insrsid7218531 , then incoming mail sent to }{\b\f2\insrsid7218531 someone@xyz.com}{\insrsid7218531  will be delivered to mailbox }{\b\f2\insrsid7218531 someone}{\insrsid7218531  in domain }{\b\f2\insrsid7218531 xyz.com}{\insrsid7218531 .
\par Note that the DNS MX record for }{\b\f2\insrsid7218531 xyz.com}{\insrsid7218531  must resolve to the IP address that is associated with domain }{\b\f2\insrsid7218531 xyz.com}{\insrsid7218531  listed here.  This is necessary so that other SMTP mail servers connect to the correct machine.  See the }{\uldb\insrsid7218531 DNS Overview}{\v\uldb\insrsid7218531 DNSOverview}{\insrsid7218531  section and the section on }{\uldb\insrsid7218531 Multiple Domains}{\v\uldb\insrsid7218531 Domains}{\insrsid7218531  for more information.
{\v0\par\v}Each virtual domain can be (but need not be) associated with one of the IP addresses on the server. If a POP3, IMAP4 or SMTP call is received at an IP address which has a domain associated with it, then the server will assume that domain name if a mailbox name without attached domain is sent by the POP3, IMAP4 or SMTP client.  If the IP address does not have a domain associated with it, then the default domain name will be assumed. (See the section on the }{\uldb\insrsid7218531 POP3 Server}{\v\uldb\insrsid7218531 POP3Server}{\insrsid7218531  for additional discussion of  how the domain name may be specified when a client logs in.)
{\v0\par\v}}\pard\plain \s3\ql \tx115\li115\ri130\sb120\sa40\keepn\widctlpar\aspalpha\aspnum\faauto\outlinelevel2\adjustright\rin130\txn115\lin115\itap0\pararsid8130183 \b\i\f1\fs24\cf17\lang1033\langfe1033\cgrid\langnp1033\langfenp1033 {\insrsid7218531 \page }{\cs98\super\insrsid7218531 #{\footnote \pard\plain \s97\ql \tx115\li115\ri130\sb80\widctlpar\aspalpha\aspnum\faauto\adjustright\rin130\txn115\lin115\itap0 \f1\fs16\lang1033\langfe1033\cgrid\langnp1033\langfenp1033 {\cs98\super\insrsid15606814 #}{\insrsid15606814  DomainGeneralPage}}${\footnote \pard\plain \s97\ql \tx115\li115\ri130\sb80\widctlpar\aspalpha\aspnum\faauto\adjustright\rin130\txn115\lin115\itap0 \f1\fs16\lang1033\langfe1033\cgrid\langnp1033\langfenp1033 {\cs98\super\insrsid15606814 $}{\insrsid15606814  Domain General Page}}K{\footnote \pard\plain \s97\ql \tx115\li115\ri130\sb80\widctlpar\aspalpha\aspnum\faauto\adjustright\rin130\txn115\lin115\itap0 \f1\fs16\lang1033\langfe1033\cgrid\langnp1033\langfenp1033 {\cs98\super\insrsid15606814 K}{\insrsid15606814  Domain General Page}}+{\footnote \pard\plain \s97\ql \tx115\li115\ri130\sb80\widctlpar\aspalpha\aspnum\faauto\adjustright\rin130\txn115\lin115\itap0 \f1\fs16\lang1033\langfe1033\cgrid\langnp1033\langfenp1033 {\cs98\super\insrsid15606814 +}{\insrsid15606814  mailsite:0000}}}{\insrsid7218531  Domain General Page }{\cs98\super\insrsid7218531 K{\footnote \pard\plain \s97\ql \tx115\li115\ri130\sb80\widctlpar\aspalpha\aspnum\faauto\adjustright\rin130\txn115\lin115\itap0 \f1\fs16\lang1033\langfe1033\cgrid\langnp1033\langfenp1033 {\cs98\super\insrsid15606814 K}{\insrsid15606814  Domains,Properties}}}{\insrsid7218531 
\par }\pard\plain \ql \tx115\li115\ri130\sb80\widctlpar\aspalpha\aspnum\faauto\adjustright\rin130\txn115\lin115\itap0 \f1\fs16\lang1033\langfe1033\cgrid\langnp1033\langfenp1033 {\insrsid7218531 You can configure the properties of the domain by double clicking on the Domain Properties icon.  The domain properties form contains tabbed property pages.  The General domain property page looks like this:
\par }{\pard\plain \ql \tx115\li115\ri130\sb80\widctlpar\aspalpha\aspnum\faauto\adjustright\rin130\txn115\lin115\itap0 \f1\fs16\lang1033\langfe1033\cgrid\langnp1033\langfenp1033\insrsid1798062 \{bmc windows console - domain properties - 256c.bmp\}}{\insrsid1798062  }{\insrsid7218531\charrsid9584679 
\par }\pard\plain \s4\ql \tx115\li115\ri130\sb80\widctlpar\aspalpha\aspnum\faauto\outlinelevel3\adjustright\rin130\txn115\lin115\itap0 \b\f2\fs16\ul\lang1033\langfe1033\cgrid\langnp1033\langfenp1033 {\insrsid7218531 Mailbox Root Directory }{\cs98\super\insrsid7218531 K{\footnote \pard\plain \s97\ql \tx115\li115\ri130\sb80\widctlpar\aspalpha\aspnum\faauto\adjustright\rin130\txn115\lin115\itap0 \f1\fs16\lang1033\langfe1033\cgrid\langnp1033\langfenp1033 {\cs98\super\insrsid15606814 K}{\insrsid15606814  Directories,Mailbox root}}}{\insrsid7218531 
\par }\pard\plain \ql \tx115\li115\ri130\sb80\widctlpar\aspalpha\aspnum\faauto\adjustright\rin130\txn115\lin115\itap0 \f1\fs16\lang1033\langfe1033\cgrid\langnp1033\langfenp1033 {\insrsid7218531 Enter the mailbox root directory that you wish to use to for the message store for your mail users.  The mailbox directory root defines the location of the directories for each mailbox.
\par A mailbox consists of two things:
\par {\pard\plain\f3\fs16\insrsid7218531 \loch\af3\dbch\af0\hich\f3 \'de\fi-720\li1080\tx1080 \tab}{\*\pntextbsx\pard\plain\f3\fs16\insrsid7218531 \loch\af3\dbch\af0\hich\f3 \'de\tab}}\pard \ql \fi-720\tx1080\li1080\ri130\sb80\widctlpar\jclisttab{\*\pnbsx \pnlvlblt\ilvl0\ls63\pnrnot0\pnf3\pnstart1\pnindent360\pnsp120\pnhang {\pntxtb \'de}}\tx1080 \aspalpha\aspnum\faauto\ls63\adjustright\rin130\txn1080\lin1080\itap0 {\b\insrsid7218531 Mailbox Properties}{\insrsid7218531 , which are stored in the Registry.  The properties are set through the Mailboxes folder in the }{\insrsid14683656 Management Center}{\insrsid7218531 .
\par {\pard\plain\f3\fs16\insrsid7218531 \loch\af3\dbch\af0\hich\f3 \'de\fi-720\li1080\tx1080 \tab}{\*\pntextbsx\pard\plain\f3\fs16\insrsid7218531 \loch\af3\dbch\af0\hich\f3 \'de\tab}}\pard \ql \fi-720\tx1080\li1080\ri130\sb80\widctlpar\jclisttab{\*\pnbsx \pnlvlblt\ilvl0\ls63\pnrnot0\pnf3\pnstart1\pnindent360\pnsp120\pnhang {\pntxtb \'de}}\tx1080 \aspalpha\aspnum\faauto\ls63\adjustright\rin130\txn1080\lin1080\itap0 {\b\insrsid7218531 Mailbox Directory}{\insrsid7218531 , whose location is determined by the mailbox directory root and whose name matches the associated mailbox.
\par }\pard \ql \tx115\li115\ri130\sb80\widctlpar\aspalpha\aspnum\faauto\adjustright\rin130\txn115\lin115\itap0 {\insrsid7218531 The mailbox directory contains a sub-directory called }{\b\f2\insrsid7218531 inbox}{\insrsid7218531  in which incoming mail is stored.  This is referred to as the }{\i\insrsid7218531 incoming mail directory}{\insrsid7218531  for that mailbox.
\par Under Windows NT, it is recommended that mailbox directories are located on a NTFS partition.  See the }{\uldb\insrsid7218531 Security }{\v\uldb\insrsid7218531 Security}{\insrsid7218531 section for additional information.
{\v0\par\v}If you wish to reset the mailbox root directory for a domain to its default value, simply leave the field blank. When you re-display the dialog, it will show the default value. The default is: }{\b\f2\insrsid7218531 C:\\}{\b\f2\insrsid6317884 Program Files\\}{\b\f2\insrsid2231627 QUALCOMM\\WorldMail}{\b\f2\insrsid6317884 \\}{\b\f2\insrsid7218531 BOX }{\cs98\b\f2\super\insrsid7218531 K{\footnote \pard\plain \s97\ql \tx115\li115\ri130\sb80\widctlpar\aspalpha\aspnum\faauto\adjustright\rin130\txn115\lin115\itap0 \f1\fs16\lang1033\langfe1033\cgrid\langnp1033\langfenp1033 {\cs98\super\insrsid15606814 K}{\insrsid15606814  Directories,BOX}}}{\insrsid7218531 
\par }\pard\plain \s4\ql \tx115\li115\ri130\sb80\widctlpar\aspalpha\aspnum\faauto\outlinelevel3\adjustright\rin130\txn115\lin115\itap0 \b\f2\fs16\ul\lang1033\langfe1033\cgrid\langnp1033\langfenp1033 {\insrsid7218531 Multi-Level Mailbox Directories
\par }\pard\plain \ql \tx115\li115\ri130\sb80\widctlpar\aspalpha\aspnum\faauto\adjustright\rin130\txn115\lin115\itap0 \f1\fs16\lang1033\langfe1033\cgrid\langnp1033\langfenp1033 {\cs98\super\insrsid7218531 K{\footnote \pard\plain \s97\ql \tx115\li115\ri130\sb80\widctlpar\aspalpha\aspnum\faauto\adjustright\rin130\txn115\lin115\itap0 \f1\fs16\lang1033\langfe1033\cgrid\langnp1033\langfenp1033 {\cs98\super\insrsid15606814 K}{\insrsid15606814  Mailboxes,Directories}}}{\insrsid7218531  }{\cs98\super\insrsid7218531 K{\footnote \pard\plain \s97\ql \tx115\li115\ri130\sb80\widctlpar\aspalpha\aspnum\faauto\adjustright\rin130\txn115\lin115\itap0 \f1\fs16\lang1033\langfe1033\cgrid\langnp1033\langfenp1033 {\cs98\super\insrsid15606814 K}{\insrsid15606814  Directories,Mailboxes}}}{\insrsid7218531 Use this option to specify that mailbox directories for the domain should be multi-level.
\par By default, mailbox directories are located within the mailbox root directory for the domain. For example, if the mailbox directory root is }{\b\f2\insrsid7218531 C:\\MAILBOX}{\insrsid7218531 , then the mailbox directory for the mailbox }{\b\f2\insrsid7218531 fred}{\insrsid7218531  will be }{\b\f2\insrsid7218531 C:\\MAILBOX\\fred}{\insrsid7218531 . However, if an extremely large number of mailbox directories exist at the same level of the file system, mail access can become less efficient and performance can be affected. For this reason, it is advisable to use multi-level mailbox directories for domains with more than 1,000 mailboxes.
\par When a domain uses this option, }{\insrsid13722995 WorldMail}{\insrsid7218531  will use the first three letters of the mailbox name (each following an exclamation mark) to construct a three-level directory path.  For example, if the mailbox directory root is }{\b\f2\insrsid7218531 C:\\MAILBOX}{\insrsid7218531 , then the multi-level mailbox directory for }{\b\f2\insrsid7218531 fred}{\insrsid7218531  will be at }{\b\f2\insrsid7218531 C:\\MAILBOX\\!f\\!r\\!e\\fred}{\insrsid7218531 .
\par It's important to know that changing this option for a domain in the Windows }{\insrsid14683656 Management Center}{\insrsid7218531  does }{\i\insrsid7218531 not}{\insrsid7218531  convert the domain's existing mailboxes to the multi-level directory structure (or back to single level). If you enable this option for an existing domain, you must manually convert the domain's mailboxes using the }{\b\f2\insrsid7218531 MSCVTDIR }{\cs98\b\f2\super\insrsid7218531 K{\footnote \pard\plain \s97\ql \tx115\li115\ri130\sb80\widctlpar\aspalpha\aspnum\faauto\adjustright\rin130\txn115\lin115\itap0 \f1\fs16\lang1033\langfe1033\cgrid\langnp1033\langfenp1033 {\cs98\super\insrsid15606814 K}{\insrsid15606814  MSCVTDIR}}}{\insrsid7218531  utility. For example, to convert mailbox directories in the domain }{\b\f2\insrsid1670342 example}{\b\f2\insrsid7218531 .com}{\insrsid7218531  to multi-level, execute:
\par }\pard\plain \s52\ql \tx115\li115\ri130\sb80\widctlpar\aspalpha\aspnum\faauto\adjustright\rin130\txn115\lin115\itap0 \b\f2\fs16\lang1033\langfe1033\cgrid\langnp1033\langfenp1033 {\insrsid7218531 mscvtdir }{\insrsid1670342 example}{\insrsid7218531 .com
\par }\pard\plain \ql \tx115\li115\ri130\sb80\widctlpar\aspalpha\aspnum\faauto\adjustright\rin130\txn115\lin115\itap0 \f1\fs16\lang1033\langfe1033\cgrid\langnp1033\langfenp1033 {\insrsid7218531 Refer to the }{\uldb\insrsid7218531 Utilities Appendix}{\v\uldb\insrsid7218531 MSCVTDIR}{\insrsid7218531  for more information on }{\b\f2\insrsid7218531 MSCVTDIR}{\insrsid7218531 .
{\v0\par\v}}\pard\plain \s4\ql \tx115\li115\ri130\sb80\widctlpar\aspalpha\aspnum\faauto\outlinelevel3\adjustright\rin130\txn115\lin115\itap0 \b\f2\fs16\ul\lang1033\langfe1033\cgrid\langnp1033\langfenp1033 {\insrsid7218531 IP Address
\par }\pard\plain \ql \tx115\li115\ri130\sb80\widctlpar\aspalpha\aspnum\faauto\adjustright\rin130\txn115\lin115\itap0 \f1\fs16\lang1033\langfe1033\cgrid\langnp1033\langfenp1033 {\cs98\super\insrsid7218531 K{\footnote \pard\plain \s97\ql \tx115\li115\ri130\sb80\widctlpar\aspalpha\aspnum\faauto\adjustright\rin130\txn115\lin115\itap0 \f1\fs16\lang1033\langfe1033\cgrid\langnp1033\langfenp1033 {\cs98\super\insrsid15606814 K}{\insrsid15606814  IP address}}}{\insrsid7218531 Use this field to select the IP address for this virtual domain. If it is set to }{\b\f2\insrsid7218531 <none>,}{\insrsid7218531  then the domain will share the IP address with the default domain.  In this case, POP3 and IMAP4 users must log in with a fully qualified user name, such as }{\b\f2\insrsid7218531 joe@abc.com}{\insrsid7218531 .
\par If you associate the virtual domain with an IP address, then the DNS record for this domain must resolve to this IP address.  In addition, users must use this DNS address as their SMTP and POP3 server. In this case, POP3 and IMAP4 users can log in with their simple name, such as }{\b\f2\insrsid7218531 joe}{\insrsid7218531 , or with their fully qualified name, such as }{\b\f2\insrsid7218531 joe@abc.com}{\insrsid7218531 .
\par See the section on }{\uldb\insrsid7218531 Multiple Domains}{\v\uldb\insrsid7218531 Domains}{\insrsid7218531  for more information.
{\v0\par\v}}\pard\plain \s4\ql \tx115\li115\ri130\sb80\widctlpar\aspalpha\aspnum\faauto\outlinelevel3\adjustright\rin130\txn115\lin115\itap0 \b\f2\fs16\ul\lang1033\langfe1033\cgrid\langnp1033\langfenp1033 {\insrsid7218531 Copy local failure reports to postmaster
\par }\pard\plain \ql \tx115\li115\ri130\sb80\widctlpar\aspalpha\aspnum\faauto\adjustright\rin130\txn115\lin115\itap0 \f1\fs16\lang1033\langfe1033\cgrid\langnp1033\langfenp1033 {\cs98\super\insrsid7218531 K{\footnote \pard\plain \s97\ql \tx115\li115\ri130\sb80\widctlpar\aspalpha\aspnum\faauto\adjustright\rin130\txn115\lin115\itap0 \f1\fs16\lang1033\langfe1033\cgrid\langnp1033\langfenp1033 {\cs98\super\insrsid15606814 K}{\insrsid15606814  Postmaster}}}{\insrsid7218531 Check this box to copy any local delivery failure reports to the postmaster in addition to the sender. Delivery failures occur when an incoming message for the selected domain is addressed to a mailbox or mail list that does not exist.
\par }\pard\plain \s4\ql \tx115\li115\ri130\sb80\widctlpar\aspalpha\aspnum\faauto\outlinelevel3\adjustright\rin130\txn115\lin115\itap0 \b\f2\fs16\ul\lang1033\langfe1033\cgrid\langnp1033\langfenp1033 {\insrsid7218531 Default Mailbox Quota Limit
\par }\pard\plain \ql \tx115\li115\ri130\sb80\widctlpar\aspalpha\aspnum\faauto\adjustright\rin130\txn115\lin115\itap0 \f1\fs16\lang1033\langfe1033\cgrid\langnp1033\langfenp1033 {\cs98\super\insrsid7218531 K{\footnote \pard\plain \s97\ql \tx115\li115\ri130\sb80\widctlpar\aspalpha\aspnum\faauto\adjustright\rin130\txn115\lin115\itap0 \f1\fs16\lang1033\langfe1033\cgrid\langnp1033\langfenp1033 {\cs98\super\insrsid15606814 K}{\insrsid15606814  Mailboxes,Quotas}}}{\insrsid7218531  }{\cs98\super\insrsid7218531 K{\footnote \pard\plain \s97\ql \tx115\li115\ri130\sb80\widctlpar\aspalpha\aspnum\faauto\adjustright\rin130\txn115\lin115\itap0 \f1\fs16\lang1033\langfe1033\cgrid\langnp1033\langfenp1033 {\cs98\super\insrsid15606814 K}{\insrsid15606814  Quotas}}}{\insrsid7218531 If quota support is licensed and enabled, the page also displays the approximate count of mailboxes, total number of messages and total message size in the domain.  You can set default values for the mailbox quota limit and for the warning level.  See the section on }{\uldb\insrsid7218531 Quotas}{\v\uldb\insrsid7218531 QuotasPage}{\insrsid7218531  for more information.
{\v0\par\v}}\pard\plain \s4\ql \tx115\li115\ri130\sb80\widctlpar\aspalpha\aspnum\faauto\outlinelevel3\adjustright\rin130\txn115\lin115\itap0 \b\f2\fs16\ul\lang1033\langfe1033\cgrid\langnp1033\langfenp1033 {\insrsid7218531 Default Mailbox Warning Level
\par }\pard\plain \ql \tx115\li115\ri130\sb80\widctlpar\aspalpha\aspnum\faauto\adjustright\rin130\txn115\lin115\itap0 \f1\fs16\lang1033\langfe1033\cgrid\langnp1033\langfenp1033 {\insrsid7218531 If quota support is licensed and enabled, use this field to set the quota warning level. This is the level of mailbox volume that will trigger a warning message to the user, alerting them that their mailbox is nearly full. See the section on }{\uldb\insrsid7218531 Quotas}{\v\uldb\insrsid7218531 QuotasPage}{\insrsid7218531  for more information.
{\v0\par\v}}\pard\plain \s4\ql \tx115\li115\ri130\sb80\widctlpar\aspalpha\aspnum\faauto\outlinelevel3\adjustright\rin130\txn115\lin115\itap0 \b\f2\fs16\ul\lang1033\langfe1033\cgrid\langnp1033\langfenp1033 {\insrsid7218531 Max Mailboxes
\par }\pard\plain \ql \tx115\li115\ri130\sb80\widctlpar\aspalpha\aspnum\faauto\adjustright\rin130\txn115\lin115\itap0 \f1\fs16\lang1033\langfe1033\cgrid\langnp1033\langfenp1033 {\insrsid7218531 You can use this field to limit the number of mailboxes that can be created in this domain.  You may wish to use this feature if you delegate management of mailboxes for this domain to your users through the Web }{\insrsid14683656 Management Center}{\insrsid7218531 .  Leave this field blank if you do not want a limit.  If you try to set the maximum value to less than number of existing mailboxes, you will be warned but will be permitted to do so.  Enter zero if you do not want to create any mailboxes in this domain.  Note that your license key may override the value that you enter here, and may further limit the number of mailboxes that can be created.
\par }\pard\plain \s4\ql \tx115\li115\ri130\sb80\widctlpar\aspalpha\aspnum\faauto\outlinelevel3\adjustright\rin130\txn115\lin115\itap0 \b\f2\fs16\ul\lang1033\langfe1033\cgrid\langnp1033\langfenp1033 {\insrsid7218531 Max Mail Lists
\par }\pard\plain \ql \tx115\li115\ri130\sb80\widctlpar\aspalpha\aspnum\faauto\adjustright\rin130\txn115\lin115\itap0 \f1\fs16\lang1033\langfe1033\cgrid\langnp1033\langfenp1033 {\insrsid7218531 You can use this field to limit the number of mail lists that can be created in this domain.  You may wish to use this feature if you delegate management of mail lists for this domain to your users through the Web }{\insrsid14683656 Management Center}{\insrsid7218531 .  Leave this field blank if you do not want a limit.  If you try to set the maximum value to less than number of existing mail lists, you will be warned, but will be permitted to do so.  Enter zero if you do not want to create any mail lists in this domain.  Note that your license key may override the value that you enter here, and may further limit the number of mail lists that can be created.
\par }\pard\plain \s4\ql \tx115\li115\ri130\sb80\widctlpar\aspalpha\aspnum\faauto\outlinelevel3\adjustright\rin130\txn115\lin115\itap0 \b\f2\fs16\ul\lang1033\langfe1033\cgrid\langnp1033\langfenp1033 {\insrsid7218531 Mail list Root }{\cs98\super\insrsid7218531 K{\footnote \pard\plain \s97\ql \tx115\li115\ri130\sb80\widctlpar\aspalpha\aspnum\faauto\adjustright\rin130\txn115\lin115\itap0 \f1\fs16\lang1033\langfe1033\cgrid\langnp1033\langfenp1033 {\cs98\super\insrsid15606814 K}{\insrsid15606814  Directories,Mailbox root}}}{\insrsid7218531  Directory
\par }\pard\plain \ql \tx115\li115\ri130\sb80\widctlpar\aspalpha\aspnum\faauto\adjustright\rin130\txn115\lin115\itap0 \f1\fs16\lang1033\langfe1033\cgrid\langnp1033\langfenp1033 {\insrsid7218531 Enter the root directory that you wish to use to for the storage of mail list messages and related information.  This mail list root directory will contain sub-directories corresponding to each mail list in the domain.  When using }{\insrsid13722995 WorldMail}{\insrsid7218531  in a clustered configuration, this root directory should be a shared file system used by each }{\insrsid13722995 WorldMail}{\insrsid7218531  node. 
\par }\pard\plain \s3\ql \tx115\li115\ri130\sb120\sa40\keepn\widctlpar\aspalpha\aspnum\faauto\outlinelevel2\adjustright\rin130\txn115\lin115\itap0\pararsid8130183 \b\i\f1\fs24\cf17\lang1033\langfe1033\cgrid\langnp1033\langfenp1033 {\insrsid7218531 \page }{\cs98\super\insrsid7218531 #{\footnote \pard\plain \s97\ql \tx115\li115\ri130\sb80\widctlpar\aspalpha\aspnum\faauto\adjustright\rin130\txn115\lin115\itap0 \f1\fs16\lang1033\langfe1033\cgrid\langnp1033\langfenp1033 {\cs98\super\insrsid15606814 #}{\insrsid15606814  DomainSynonymsPage}}${\footnote \pard\plain \s97\ql \tx115\li115\ri130\sb80\widctlpar\aspalpha\aspnum\faauto\adjustright\rin130\txn115\lin115\itap0 \f1\fs16\lang1033\langfe1033\cgrid\langnp1033\langfenp1033 {\cs98\super\insrsid15606814 $}{\insrsid15606814  Domain Synonyms Page}}K{\footnote \pard\plain \s97\ql \tx115\li115\ri130\sb80\widctlpar\aspalpha\aspnum\faauto\adjustright\rin130\txn115\lin115\itap0 \f1\fs16\lang1033\langfe1033\cgrid\langnp1033\langfenp1033 {\cs98\super\insrsid15606814 K}{\insrsid15606814  Domain Synonyms Page}}+{\footnote \pard\plain \s97\ql \tx115\li115\ri130\sb80\widctlpar\aspalpha\aspnum\faauto\adjustright\rin130\txn115\lin115\itap0 \f1\fs16\lang1033\langfe1033\cgrid\langnp1033\langfenp1033 {\cs98\super\insrsid15606814 +}{\insrsid15606814  mailsite:0000}}}{\insrsid7218531  Domain Synonyms Page }{\cs98\super\insrsid7218531 K{\footnote \pard\plain \s97\ql \tx115\li115\ri130\sb80\widctlpar\aspalpha\aspnum\faauto\adjustright\rin130\txn115\lin115\itap0 \f1\fs16\lang1033\langfe1033\cgrid\langnp1033\langfenp1033 {\cs98\super\insrsid15606814 K}{\insrsid15606814  Domains,Synonyms}}}{\insrsid7218531 
\par }\pard\plain \ql \tx115\li115\ri130\sb80\widctlpar\aspalpha\aspnum\faauto\adjustright\rin130\txn115\lin115\itap0 \f1\fs16\lang1033\langfe1033\cgrid\langnp1033\langfenp1033 {\insrsid7218531 The }{\b\insrsid7218531 Synonyms}{\insrsid7218531  page of the Domain Property dialog looks like this:
