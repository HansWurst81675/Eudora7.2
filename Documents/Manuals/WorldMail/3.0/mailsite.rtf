\par }\pard\plain \s90\ql \tx115\li115\ri130\sb120\sa120\keepn\widctlpar\aspalpha\aspnum\faauto\outlinelevel0\adjustright\rin130\txn115\lin115\itap0\pararsid13850433 \b\f1\fs40\cf17\lang1033\langfe1033\cgrid\langnp1033\langfenp1033 {\cs113\f4\insrsid7218531\charrsid1928375 \page }{\cs98\cf0\super\insrsid7218531 #{\footnote \pard\plain \s97\ql \tx115\li115\ri130\sb80\widctlpar\aspalpha\aspnum\faauto\adjustright\rin130\txn115\lin115\itap0 \f1\fs16\lang1033\langfe1033\cgrid\langnp1033\langfenp1033 {\cs98\super\insrsid15606814 #}{\insrsid15606814  ListHeaderProcessing}}${\footnote \pard\plain \s97\ql \tx115\li115\ri130\sb80\widctlpar\aspalpha\aspnum\faauto\adjustright\rin130\txn115\lin115\itap0 \f1\fs16\lang1033\langfe1033\cgrid\langnp1033\langfenp1033 {\cs98\super\insrsid15606814 $}{\insrsid15606814  List Header Processing}}K{\footnote \pard\plain \s97\ql \tx115\li115\ri130\sb80\widctlpar\aspalpha\aspnum\faauto\adjustright\rin130\txn115\lin115\itap0 \f1\fs16\lang1033\langfe1033\cgrid\langnp1033\langfenp1033 {\cs98\super\insrsid15606814 K}{\insrsid15606814  List Header Processing}}+{\footnote \pard\plain \s97\ql \tx115\li115\ri130\sb80\widctlpar\aspalpha\aspnum\faauto\adjustright\rin130\txn115\lin115\itap0 \f1\fs16\lang1033\langfe1033\cgrid\langnp1033\langfenp1033 {\cs98\super\insrsid15606814 +}{\insrsid15606814  mailsite:0000}}}{\cs113\f4\insrsid7218531\charrsid1928375  Appendix E - List Header Processing
\par }\pard\plain \s3\ql \tx115\li115\ri130\sb120\sa40\widctlpar\aspalpha\aspnum\faauto\outlinelevel2\adjustright\rin130\txn115\lin115\itap0 \b\i\f1\fs24\cf17\lang1033\langfe1033\cgrid\langnp1033\langfenp1033 {\cs98\super\insrsid7218531 #{\footnote \pard\plain \s97\ql \tx115\li115\ri130\sb80\widctlpar\aspalpha\aspnum\faauto\adjustright\rin130\txn115\lin115\itap0 \f1\fs16\lang1033\langfe1033\cgrid\langnp1033\langfenp1033 {\cs98\super\insrsid15606814 #}{\insrsid15606814  HeaderProcessingScriptSyntax}}K{\footnote \pard\plain \s97\ql \tx115\li115\ri130\sb80\widctlpar\aspalpha\aspnum\faauto\adjustright\rin130\txn115\lin115\itap0 \f1\fs16\lang1033\langfe1033\cgrid\langnp1033\langfenp1033 {\cs98\super\insrsid15606814 K}{\insrsid15606814  Header Processing Script Syntax}}}{\insrsid7218531  }{\cs98\super\insrsid7218531 K{\footnote \pard\plain \s97\ql \tx115\li115\ri130\sb80\widctlpar\aspalpha\aspnum\faauto\adjustright\rin130\txn115\lin115\itap0 \f1\fs16\lang1033\langfe1033\cgrid\langnp1033\langfenp1033 {\cs98\super\insrsid15606814 K}{\insrsid15606814  Mail lists,Header processing}}}{\insrsid7218531 Header Processing Script Syntax
\par }\pard\plain \ql \tx115\li115\ri130\sb80\widctlpar\aspalpha\aspnum\faauto\outlinelevel0\adjustright\rin130\txn115\lin115\itap0 \f1\fs16\lang1033\langfe1033\cgrid\langnp1033\langfenp1033 {\b\f2\insrsid7218531 Syntax:  ADD headertemplate
\par Example: ADD X-advert: For great widgets, visit www.widgets.com
\par }\pard \ql \tx115\li115\ri130\sb80\widctlpar\aspalpha\aspnum\faauto\adjustright\rin130\txn115\lin115\itap0 {\insrsid7218531 Adds the given header text to the end of the headers on the message. Any pre-existing headers of the same type are left unaltered. In the header template, the following combinations have effect: }{\b\f2\insrsid7218531 %%}{\insrsid7218531  is replaced by a single }{\b\f2\insrsid7218531 %}{\insrsid7218531 \'3b }{\b\f2\insrsid7218531 %d}{\insrsid7218531  is replaced by the current date and time.
\par }\pard \ql \tx115\li115\ri130\sb80\widctlpar\aspalpha\aspnum\faauto\outlinelevel0\adjustright\rin130\txn115\lin115\itap0 {\b\f2\insrsid7218531 Syntax:  REMOVE header
\par Example: REMOVE Return-receipt-to:
\par }\pard \ql \tx115\li115\ri130\sb80\widctlpar\aspalpha\aspnum\faauto\adjustright\rin130\txn115\lin115\itap0 {\insrsid7218531 Removes all headers of the given type from the message. Case is not significant when matching header names. The terminating colon is required.
\par }\pard \ql \tx115\li115\ri130\sb80\widctlpar\aspalpha\aspnum\faauto\outlinelevel0\adjustright\rin130\txn115\lin115\itap0 {\b\f2\insrsid7218531 Syntax:  REWRITE header AS headertemplate
\par Example: REWRITE X-Sender: AS X-OriginalSender: %v
\par }\pard \ql \tx115\li115\ri130\sb80\widctlpar\aspalpha\aspnum\faauto\adjustright\rin130\txn115\lin115\itap0 {\insrsid7218531 Replaces the first occurrence of the header with the header template. In the header template, the following combinations have effect: }{\b\f2\insrsid7218531 %%}{\insrsid7218531  is replaced by a single }{\b\f2\insrsid7218531 %}{\insrsid7218531 \'3b }{\b\f2\insrsid7218531 %v}{\insrsid7218531  is replaced by the original value of the header\'3b }{\b\f2\insrsid7218531 %d}{\insrsid7218531  is replaced by the current date and time.
\par }\pard \ql \tx115\li115\ri130\sb80\widctlpar\aspalpha\aspnum\faauto\outlinelevel0\adjustright\rin130\txn115\lin115\itap0 {\b\f2\insrsid7218531 Syntax:  IFPRESENT header GOTO label
\par Example: IFPRESENT Cc: GOTO ccpresent
\par }\pard \ql \tx115\li115\ri130\sb80\widctlpar\aspalpha\aspnum\faauto\adjustright\rin130\txn115\lin115\itap0 {\insrsid7218531 If the header is present in the message, continue processing the script commands from the label. If the mailing list is not "trusted" (see above), only "forward" gotos are possible, to eliminate the possibility of an infinite loop.
\par }\pard \ql \tx115\li115\ri130\sb80\widctlpar\aspalpha\aspnum\faauto\outlinelevel0\adjustright\rin130\txn115\lin115\itap0 {\b\f2\insrsid7218531 Syntax:  IFABSENT header GOTO label
\par Example: IFABSENT Cc: GOTO ccabsent
\par }\pard \ql \tx115\li115\ri130\sb80\widctlpar\aspalpha\aspnum\faauto\adjustright\rin130\txn115\lin115\itap0 {\insrsid7218531 If the header is not present in the message, continue processing the script commands from the label. If the mailing list is not "trusted", only "forward" gotos are possible, to eliminate the possibility of an infinite loop.
\par }\pard \ql \tx115\li115\ri130\sb80\widctlpar\aspalpha\aspnum\faauto\outlinelevel0\adjustright\rin130\txn115\lin115\itap0 {\b\f2\insrsid7218531 Syntax:  IFCONTAINS header text GOTO label
\par Example: IFCONTAINS Subject: xyz GOTO alabel
\par }\pard \ql \tx115\li115\ri130\sb80\widctlpar\aspalpha\aspnum\faauto\adjustright\rin130\txn115\lin115\itap0 {\insrsid7218531 If the }{\i\f2\insrsid7218531 header }{\insrsid7218531 is present in the message, and the value of the header contains (as a substring) }{\i\f2\insrsid7218531 text}{\insrsid7218531 , continue processing the script commands from the }{\i\f2\insrsid7218531 label}{\insrsid7218531 .  (Note that the }{\i\f2\insrsid7218531 text}{\insrsid7218531  may not contain white space.)  If the mail list is not "trusted" (see above), only "forward" gotos are possible, to eliminate the possibility of an infinite loop.
\par }\pard \ql \tx115\li115\ri130\sb80\widctlpar\aspalpha\aspnum\faauto\outlinelevel0\adjustright\rin130\txn115\lin115\itap0 {\b\f2\insrsid7218531 Syntax:  ABORT [recipient]
\par Example: ABORT postmaster@mydomain.com
\par }\pard \ql \tx115\li115\ri130\sb80\widctlpar\aspalpha\aspnum\faauto\adjustright\rin130\txn115\lin115\itap0 {\insrsid7218531 The message is not sent to the mailing list. If the optional argument recipient is present, the message is forwarded to that address.
\par }\pard \ql \tx115\li115\ri130\sb80\widctlpar\aspalpha\aspnum\faauto\outlinelevel0\adjustright\rin130\txn115\lin115\itap0 {\b\f2\insrsid7218531 Syntax:  :label
\par Example: :ccpresent
\par }\pard \ql \tx115\li115\ri130\sb80\widctlpar\aspalpha\aspnum\faauto\adjustright\rin130\txn115\lin115\itap0 {\insrsid7218531 A colon introduces a label, which can be the target of an }{\b\f2\insrsid7218531 IF... GOTO}{\insrsid7218531  command, as previously described. Label names may not contain space - everything after the space is ignored.
\par Note that after the mailing list header script has been executed, the mailing list processor will do its own, built-in header processing. It will rewrite any }{\b\f2\insrsid7218531 Sender}{\insrsid7218531 : headers as }{\b\f2\insrsid7218531 Original-sender}{\insrsid7218531 : and add its own }{\b\f2\insrsid7218531 Sender}{\insrsid7218531 : field. (This is to help prevent mailing list loops - your mailing list script should never remove any }{\b\f2\insrsid7218531 Original-sender:}{\insrsid7218531  or }{\b\f2\insrsid7218531 Sender:}{\insrsid7218531  headers, otherwise disastrous mailing loops can result.) If the }{\b\f2\insrsid7218531 Reply to list}{\insrsid7218531  feature is enabled, the mailing list processor will add a }{\b\f2\insrsid7218531 Reply-to}{\insrsid7218531 : field if there isn't one already present.
\par You should be aware that there are certain headers that can cause Message Delivered acknowledgement messages to be sent. It is a good idea to remove these headers using a script. As a minimum, therefore, your script should contain:
\par }{\b\f2\insrsid7218531 REMOVE Return-receipt-to:\txne\line REMOVE X-Confirm-reading-to:\txne\line REMOVE X-pmrqc:
\par }\pard\plain \s90\ql \tx115\li115\ri130\sb120\sa120\keepn\widctlpar\aspalpha\aspnum\faauto\outlinelevel0\adjustright\rin130\txn115\lin115\itap0\pararsid13850433 \b\f1\fs40\cf17\lang1033\langfe1033\cgrid\langnp1033\langfenp1033 {\cs113\f4\insrsid7218531\charrsid1928375 \page }{\cs98\cf0\super\insrsid7218531 #{\footnote \pard\plain \s97\ql \tx115\li115\ri130\sb80\widctlpar\aspalpha\aspnum\faauto\adjustright\rin130\txn115\lin115\itap0 \f1\fs16\lang1033\langfe1033\cgrid\langnp1033\langfenp1033 {\cs98\super\insrsid15606814 #}{\insrsid15606814  DatabasePluginExamples}}${\footnote \pard\plain \s97\ql \tx115\li115\ri130\sb80\widctlpar\aspalpha\aspnum\faauto\adjustright\rin130\txn115\lin115\itap0 \f1\fs16\lang1033\langfe1033\cgrid\langnp1033\langfenp1033 {\cs98\super\insrsid15606814 $}{\insrsid15606814  Database Plugin Examples}}K{\footnote \pard\plain \s97\ql \tx115\li115\ri130\sb80\widctlpar\aspalpha\aspnum\faauto\adjustright\rin130\txn115\lin115\itap0 \f1\fs16\lang1033\langfe1033\cgrid\langnp1033\langfenp1033 {\cs98\super\insrsid15606814 K}{\insrsid15606814  Database Plugin Examples}}+{\footnote \pard\plain \s97\ql \tx115\li115\ri130\sb80\widctlpar\aspalpha\aspnum\faauto\adjustright\rin130\txn115\lin115\itap0 \f1\fs16\lang1033\langfe1033\cgrid\langnp1033\langfenp1033 {\cs98\super\insrsid15606814 +}{\insrsid15606814  mailsite:0000}}}{\cs113\f4\insrsid7218531\charrsid1928375  Appendix F - Database Plugin Examples
