\par }\pard\plain \s3\ql \tx115\li115\ri130\sb120\sa40\keepn\widctlpar\aspalpha\aspnum\faauto\outlinelevel2\adjustright\rin130\txn115\lin115\itap0\pararsid8130183 \b\i\f1\fs24\cf17\lang1033\langfe1033\cgrid\langnp1033\langfenp1033 {\insrsid7218531 \page }{\cs98\super\insrsid7218531 #{\footnote \pard\plain \s97\ql \tx115\li115\ri130\sb80\widctlpar\aspalpha\aspnum\faauto\adjustright\rin130\txn115\lin115\itap0 \f1\fs16\lang1033\langfe1033\cgrid\langnp1033\langfenp1033 {\cs98\super\insrsid15606814 #}{\insrsid15606814  NTMailboxPluginConfiguration}}${\footnote \pard\plain \s97\ql \tx115\li115\ri130\sb80\widctlpar\aspalpha\aspnum\faauto\adjustright\rin130\txn115\lin115\itap0 \f1\fs16\lang1033\langfe1033\cgrid\langnp1033\langfenp1033 {\cs98\super\insrsid15606814 $}{\insrsid15606814  NT Mailbox Plugin Configuration}}K{\footnote \pard\plain \s97\ql \tx115\li115\ri130\sb80\widctlpar\aspalpha\aspnum\faauto\adjustright\rin130\txn115\lin115\itap0 \f1\fs16\lang1033\langfe1033\cgrid\langnp1033\langfenp1033 {\cs98\super\insrsid15606814 K}{\insrsid15606814  NT Mailbox Plugin Configuration}}+{\footnote \pard\plain \s97\ql \tx115\li115\ri130\sb80\widctlpar\aspalpha\aspnum\faauto\adjustright\rin130\txn115\lin115\itap0 \f1\fs16\lang1033\langfe1033\cgrid\langnp1033\langfenp1033 {\cs98\super\insrsid15606814 +}{\insrsid15606814  mailsite:0000}}}{\insrsid7218531  NT Mailbox Plugin Configuration }{\cs98\super\insrsid7218531 K{\footnote \pard\plain \s97\ql \tx115\li115\ri130\sb80\widctlpar\aspalpha\aspnum\faauto\adjustright\rin130\txn115\lin115\itap0 \f1\fs16\lang1033\langfe1033\cgrid\langnp1033\langfenp1033 {\cs98\super\insrsid15606814 K}{\insrsid15606814  NT Mailbox plugin}}}{\insrsid7218531  }{\cs98\super\insrsid7218531 K{\footnote \pard\plain \s97\ql \tx115\li115\ri130\sb80\widctlpar\aspalpha\aspnum\faauto\adjustright\rin130\txn115\lin115\itap0 \f1\fs16\lang1033\langfe1033\cgrid\langnp1033\langfenp1033 {\cs98\super\insrsid15606814 K}{\insrsid15606814  Plugins,NT mailbox}}}{\insrsid7218531  }{\cs98\super\insrsid7218531 K{\footnote \pard\plain \s97\ql \tx115\li115\ri130\sb80\widctlpar\aspalpha\aspnum\faauto\adjustright\rin130\txn115\lin115\itap0 \f1\fs16\lang1033\langfe1033\cgrid\langnp1033\langfenp1033 {\cs98\super\insrsid15606814 K}{\insrsid15606814  Mailboxes,NT}}}{\insrsid7218531 
