\par }\pard\plain \s90\ql \tx115\li115\ri130\sb120\sa120\keepn\widctlpar\aspalpha\aspnum\faauto\outlinelevel0\adjustright\rin130\txn115\lin115\itap0\pararsid13850433 \b\f1\fs40\cf17\lang1033\langfe1033\cgrid\langnp1033\langfenp1033 {\cs113\f4\insrsid7218531\charrsid1928375 \page }{\cs98\cf0\super\insrsid7218531 #{\footnote \pard\plain \s97\ql \tx115\li115\ri130\sb80\widctlpar\aspalpha\aspnum\faauto\adjustright\rin130\txn115\lin115\itap0 \f1\fs16\lang1033\langfe1033\cgrid\langnp1033\langfenp1033 {\cs98\super\insrsid15606814 #}{\insrsid15606814  DatabaseLogging}}${\footnote \pard\plain \s97\ql \tx115\li115\ri130\sb80\widctlpar\aspalpha\aspnum\faauto\adjustright\rin130\txn115\lin115\itap0 \f1\fs16\lang1033\langfe1033\cgrid\langnp1033\langfenp1033 {\cs98\super\insrsid15606814 $}{\insrsid15606814  Database Logging}}K{\footnote \pard\plain \s97\ql \tx115\li115\ri130\sb80\widctlpar\aspalpha\aspnum\faauto\adjustright\rin130\txn115\lin115\itap0 \f1\fs16\lang1033\langfe1033\cgrid\langnp1033\langfenp1033 {\cs98\super\insrsid15606814 K}{\insrsid15606814  Database Logging}}+{\footnote \pard\plain \s97\ql \tx115\li115\ri130\sb80\widctlpar\aspalpha\aspnum\faauto\adjustright\rin130\txn115\lin115\itap0 \f1\fs16\lang1033\langfe1033\cgrid\langnp1033\langfenp1033 {\cs98\super\insrsid15606814 +}{\insrsid15606814  mailsite:0000}}}{\cs113\f4\insrsid7218531\charrsid1928375  Appendix G - Database Logging
\par }\pard\plain \ql \tx115\li115\ri130\sb80\widctlpar\aspalpha\aspnum\faauto\adjustright\rin130\txn115\lin115\itap0 \f1\fs16\lang1033\langfe1033\cgrid\langnp1033\langfenp1033 {\cs98\super\insrsid7218531 K{\footnote \pard\plain \s97\ql \tx115\li115\ri130\sb80\widctlpar\aspalpha\aspnum\faauto\adjustright\rin130\txn115\lin115\itap0 \f1\fs16\lang1033\langfe1033\cgrid\langnp1033\langfenp1033 {\cs98\super\insrsid15606814 K}{\insrsid15606814  Logging}}}{\insrsid7218531 You can configure }{\insrsid13722995 WorldMail}{\insrsid7218531  to log operational information to any ODBC database.  This section explains how to configure }{\insrsid13722995 WorldMail}{\insrsid7218531  to do this.
\par There are three steps:
\par {\pard\plain\f3\fs16\insrsid7218531 \loch\af3\dbch\af0\hich\f3 \'de\fi-360\li115\tx115 \tab}{\*\pntextbsx\pard\plain\f3\fs16\insrsid7218531 \loch\af3\dbch\af0\hich\f3 \'de\tab}}\pard \ql \fi-720\tx1080\li1080\ri130\sb80\widctlpar\jclisttab{\*\pnbsx \pnlvlblt\ilvl0\ls86\pnrnot0\pnf3\pnstart1\pnindent360\pnsp120\pnhang {\pntxtb \'de}}\tx1080 \aspalpha\aspnum\faauto\ls86\adjustright\rin130\txn1080\lin1080\itap0 {\insrsid7218531 Setting up the database
\par {\pard\plain\f3\fs16\insrsid7218531 \loch\af3\dbch\af0\hich\f3 \'de\fi-720\li1080\tx1080 \tab}{\*\pntextbsx\pard\plain\f3\fs16\insrsid7218531 \loch\af3\dbch\af0\hich\f3 \'de\tab}}\pard \ql \fi-720\tx1080\li1080\ri130\sb80\widctlpar\jclisttab{\*\pnbsx \pnlvlblt\ilvl0\ls86\pnrnot0\pnf3\pnstart1\pnindent360\pnsp120\pnhang {\pntxtb \'de}}\tx1080 \aspalpha\aspnum\faauto\ls86\adjustright\rin130\txn1080\lin1080\itap0 {\insrsid7218531 Configuring }{\insrsid13722995 WorldMail}{\insrsid7218531 
\par {\pard\plain\f3\fs16\insrsid7218531 \loch\af3\dbch\af0\hich\f3 \'de\fi-720\li1080\tx1080 \tab}{\*\pntextbsx\pard\plain\f3\fs16\insrsid7218531 \loch\af3\dbch\af0\hich\f3 \'de\tab}}\pard \ql \fi-720\tx1080\li1080\ri130\sb80\widctlpar\jclisttab{\*\pnbsx \pnlvlblt\ilvl0\ls86\pnrnot0\pnf3\pnstart1\pnindent360\pnsp120\pnhang {\pntxtb \'de}}\tx1080 \aspalpha\aspnum\faauto\ls86\adjustright\rin130\txn1080\lin1080\itap0 {\insrsid7218531 Retrieving the logged information
\par }\pard\plain \s35\ql \tx115\li115\ri130\sb80\widctlpar\aspalpha\aspnum\faauto\adjustright\rin130\txn115\lin115\itap0 \f1\fs16\lang1033\langfe1033\cgrid\langnp1033\langfenp1033 {\insrsid7218531 We will discuss each of these in turn.
\par }\pard\plain \s3\ql \tx115\li115\ri130\sb120\sa40\widctlpar\aspalpha\aspnum\faauto\outlinelevel2\adjustright\rin130\txn115\lin115\itap0 \b\i\f1\fs24\cf17\lang1033\langfe1033\cgrid\langnp1033\langfenp1033 {\cs98\super\insrsid7218531 #{\footnote \pard\plain \s97\ql \tx115\li115\ri130\sb80\widctlpar\aspalpha\aspnum\faauto\adjustright\rin130\txn115\lin115\itap0 \f1\fs16\lang1033\langfe1033\cgrid\langnp1033\langfenp1033 {\cs98\super\insrsid15606814 #}{\insrsid15606814  Settingupthedatabase}}K{\footnote \pard\plain \s97\ql \tx115\li115\ri130\sb80\widctlpar\aspalpha\aspnum\faauto\adjustright\rin130\txn115\lin115\itap0 \f1\fs16\lang1033\langfe1033\cgrid\langnp1033\langfenp1033 {\cs98\super\insrsid15606814 K}{\insrsid15606814  Setting up the database}}}{\insrsid7218531  Setting up the database
\par }\pard\plain \ql \tx115\li115\ri130\sb80\widctlpar\aspalpha\aspnum\faauto\adjustright\rin130\txn115\lin115\itap0 \f1\fs16\lang1033\langfe1033\cgrid\langnp1033\langfenp1033 {\insrsid7218531 You need a database that supports ODBC, such as Microsoft SQL Server (for busy sites) or Microsoft Access (less busy sites).  You will probably wish to create a new database for }{\insrsid13722995 WorldMail}{\insrsid7218531 , although you can use an existing database if you want.  If your database package supports authentication you may also wish to create a database login ID and password for }{\insrsid13722995 WorldMail}{\insrsid7218531  to use.
