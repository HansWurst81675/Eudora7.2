\par }\pard\plain \s2\ql \tx115\li115\ri130\sb120\sa40\keepn\widctlpar\aspalpha\aspnum\faauto\outlinelevel1\adjustright\rin130\txn115\lin115\itap0\pararsid8130183 \b\f1\fs28\cf17\lang1033\langfe1033\cgrid\langnp1033\langfenp1033 {\insrsid7218531 \page }{\cs98\super\insrsid7218531 #{\footnote \pard\plain \s97\ql \tx115\li115\ri130\sb80\widctlpar\aspalpha\aspnum\faauto\adjustright\rin130\txn115\lin115\itap0 \f1\fs16\lang1033\langfe1033\cgrid\langnp1033\langfenp1033 {\cs98\super\insrsid15606814 #}{\insrsid15606814  SchedulesFolder}}${\footnote \pard\plain \s97\ql \tx115\li115\ri130\sb80\widctlpar\aspalpha\aspnum\faauto\adjustright\rin130\txn115\lin115\itap0 \f1\fs16\lang1033\langfe1033\cgrid\langnp1033\langfenp1033 {\cs98\super\insrsid15606814 $}{\insrsid15606814  Schedules Folder}}K{\footnote \pard\plain \s97\ql \tx115\li115\ri130\sb80\widctlpar\aspalpha\aspnum\faauto\adjustright\rin130\txn115\lin115\itap0 \f1\fs16\lang1033\langfe1033\cgrid\langnp1033\langfenp1033 {\cs98\super\insrsid15606814 K}{\insrsid15606814  Schedules Folder}}+{\footnote \pard\plain \s97\ql \tx115\li115\ri130\sb80\widctlpar\aspalpha\aspnum\faauto\adjustright\rin130\txn115\lin115\itap0 \f1\fs16\lang1033\langfe1033\cgrid\langnp1033\langfenp1033 {\cs98\super\insrsid15606814 +}{\insrsid15606814  mailsite:0000}}}{\insrsid7218531  Schedules
\par }\pard\plain \ql \tx115\li115\ri130\sb80\widctlpar\aspalpha\aspnum\faauto\adjustright\rin130\txn115\lin115\itap0 \f1\fs16\lang1033\langfe1033\cgrid\langnp1033\langfenp1033 {\cs98\super\insrsid7218531 K{\footnote \pard\plain \s97\ql \tx115\li115\ri130\sb80\widctlpar\aspalpha\aspnum\faauto\adjustright\rin130\txn115\lin115\itap0 \f1\fs16\lang1033\langfe1033\cgrid\langnp1033\langfenp1033 {\cs98\super\insrsid15606814 K}{\insrsid15606814  Schedules}}}{\insrsid7218531 Use the items in this folder to enable and configure delivery schedules and dialup connectivity.
\par }{\pard\plain \ql \tx115\li115\ri130\sb80\widctlpar\aspalpha\aspnum\faauto\adjustright\rin130\txn115\lin115\itap0 \f1\fs16\lang1033\langfe1033\cgrid\langnp1033\langfenp1033\insrsid6780023 \{bmc windows console - schedules - 256c.bmp\}}{\insrsid6780023  }{\insrsid7218531\charrsid6780023 
\par }{\insrsid7218531 Delivery to remote domains can be schedule using two different methods.  The Schedule Management form allows you to choose which method you wish to use for which domain.
\par The two methods are: }{\b\f2\insrsid7218531 Elapsed Time}{\insrsid7218531  and }{\b\f2\insrsid7218531 Time of Day}{\insrsid7218531 .
\par }\pard\plain \s3\ql \tx115\li115\ri130\sb120\sa40\keepn\widctlpar\aspalpha\aspnum\faauto\outlinelevel2\adjustright\rin130\txn115\lin115\itap0\pararsid8130183 \b\i\f1\fs24\cf17\lang1033\langfe1033\cgrid\langnp1033\langfenp1033 {\insrsid7218531 \page }{\cs98\super\insrsid7218531 #{\footnote \pard\plain \s97\ql \tx115\li115\ri130\sb80\widctlpar\aspalpha\aspnum\faauto\adjustright\rin130\txn115\lin115\itap0 \f1\fs16\lang1033\langfe1033\cgrid\langnp1033\langfenp1033 {\cs98\super\insrsid15606814 #}{\insrsid15606814  ScheduleManagement}}${\footnote \pard\plain \s97\ql \tx115\li115\ri130\sb80\widctlpar\aspalpha\aspnum\faauto\adjustright\rin130\txn115\lin115\itap0 \f1\fs16\lang1033\langfe1033\cgrid\langnp1033\langfenp1033 {\cs98\super\insrsid15606814 $}{\insrsid15606814  Schedule Management}}K{\footnote \pard\plain \s97\ql \tx115\li115\ri130\sb80\widctlpar\aspalpha\aspnum\faauto\adjustright\rin130\txn115\lin115\itap0 \f1\fs16\lang1033\langfe1033\cgrid\langnp1033\langfenp1033 {\cs98\super\insrsid15606814 K}{\insrsid15606814  Schedule Management}}+{\footnote \pard\plain \s97\ql \tx115\li115\ri130\sb80\widctlpar\aspalpha\aspnum\faauto\adjustright\rin130\txn115\lin115\itap0 \f1\fs16\lang1033\langfe1033\cgrid\langnp1033\langfenp1033 {\cs98\super\insrsid15606814 +}{\insrsid15606814  mailsite:0000}}}{\insrsid7218531  Schedule Management }{\cs98\super\insrsid7218531 K{\footnote \pard\plain \s97\ql \tx115\li115\ri130\sb80\widctlpar\aspalpha\aspnum\faauto\adjustright\rin130\txn115\lin115\itap0 \f1\fs16\lang1033\langfe1033\cgrid\langnp1033\langfenp1033 {\cs98\super\insrsid15606814 K}{\insrsid15606814  Schedule Management}}}{\insrsid7218531 
\par }\pard\plain \ql \tx115\li115\ri130\sb80\widctlpar\aspalpha\aspnum\faauto\adjustright\rin130\txn115\lin115\itap0 \f1\fs16\lang1033\langfe1033\cgrid\langnp1033\langfenp1033 {\insrsid7218531 Use the Schedule Management dialog to specify which domains will use the elapsed time schedule and which will use the time-of-day schedule.  It is also used to initiate an immediate delivery attempt of messages for specified domains.
\par }{\pard\plain \ql \tx115\li115\ri130\sb80\widctlpar\aspalpha\aspnum\faauto\adjustright\rin130\txn115\lin115\itap0 \f1\fs16\lang1024\langfe1024\cgrid\noproof\langnp1033\langfenp1033\insrsid6780023 \{bmc windows console - schedules - mgt - 256c.bmp\}}{\lang1024\langfe1024\noproof\insrsid6780023  }{\insrsid7218531\charrsid6780023 
\par }\pard\plain \s4\ql \tx115\li115\ri130\sb80\widctlpar\aspalpha\aspnum\faauto\outlinelevel3\adjustright\rin130\txn115\lin115\itap0 \b\f2\fs16\ul\lang1033\langfe1033\cgrid\langnp1033\langfenp1033 {\lang2057\langfe1033\langnp2057\insrsid7218531 Map domains to delivery schedules
\par }\pard\plain \ql \tx115\li115\ri130\sb80\widctlpar\aspalpha\aspnum\faauto\adjustright\rin130\txn115\lin115\itap0 \f1\fs16\lang1033\langfe1033\cgrid\langnp1033\langfenp1033 {\insrsid7218531 Enter a list of domain names, separated by commas.  The list is processed from left to right.  You may specify }{\b\f2\insrsid7218531 *}{\insrsid7218531  as part of a domain name, representing a wildcard. You can also have an exclamation mark }{\b\f2\insrsid7218531 !}{\insrsid7218531  in front of a domain name, indicating that matching domains don't belong in the list.
\par Messages for foreign domains that match this list will be delivered according to the elapsed time schedule.  By default, this field contains a single asterisk, meaning that all foreign domains use the elapsed time schedule.  If you wish all foreign domains to use the time-of-day schedule instead (for instance, if you have a dialup connection to the Internet), you should enter the value }{\b\f2\insrsid7218531 !*}{\insrsid7218531  in this field.
\par For example, suppose your }{\insrsid13722995 WorldMail}{\insrsid7218531  system is located at company HQ, and is hosting a single domain }{\b\f2\insrsid7218531 engineering.mycompany.com}{\insrsid7218531 .  It is running on the HQ Intranet that contains other mail servers, hosting domains like }{\b\f2\insrsid7218531 sales.mycompany.com}{\insrsid7218531 . Your company's Internet connection is established only at certain times of the day.  There is a branch office in another country, not connected to the company Intranet, but which has its own Internet connection and has a mail server hosting the domain }{\b\f2\insrsid7218531 italy.mycompany.com}{\insrsid7218531 . In these circumstances, you might want to set the domain mask string to:
\par {\pard\plain\s52 \f3\fs16\insrsid7218531 \loch\af3\dbch\af0\hich\f3 \'de\fi-720\li115\tx115 \tab}{\*\pntextbsx\pard\plain\s52 \f3\fs16\insrsid7218531 \loch\af3\dbch\af0\hich\f3 \'de\tab}}\pard\plain \s52\ql \fi-720\tx1080\li1080\ri130\sb80\widctlpar\jclisttab{\*\pnbsx \pnlvlblt\ilvl0\ls60\pnrnot0\pnf3\pnstart1\pnindent360\pnsp120\pnhang {\pntxtb \'de}}\tx1080 \aspalpha\aspnum\faauto\ls60\adjustright\rin130\txn1080\lin1080\itap0 \b\f2\fs16\lang1033\langfe1033\cgrid\langnp1033\langfenp1033 {\insrsid7218531 !italy.mycompany.com,*mycompany.com,!*
\par }\pard\plain \ql \tx115\li115\ri130\sb80\widctlpar\aspalpha\aspnum\faauto\adjustright\rin130\txn115\lin115\itap0 \f1\fs16\lang1033\langfe1033\cgrid\langnp1033\langfenp1033 {\insrsid7218531 This ensures that mail to }{\b\f2\insrsid7218531 users@italy.mycompany.com }{\insrsid7218531 would be scheduled for delivery according to the time-of-day schedule, whereas mail to }{\b\f2\insrsid7218531 users@anywhere.else.mycompany.com }{\insrsid7218531 would be scheduled according to the elapsed time schedule (since it is destined for servers on the local Intranet). All other foreign mail would be delivered according to the time-of-day schedule.
\par Note that this field has nothing to do with routing, which is always performed according to the DNS and the manual routing table. In the above example, you might wish to route mail to }{\b\f2\insrsid7218531 italy.mycompany.com }{\insrsid7218531 and mail to domains outside the company via your ISP's mail server, and route mail to the other domains within your company in a different way. You should use the Routing dialog to achieve this.
\par }\pard\plain \s4\ql \tx115\li115\ri130\sb80\widctlpar\aspalpha\aspnum\faauto\outlinelevel3\adjustright\rin130\txn115\lin115\itap0 \b\f2\fs16\ul\lang1033\langfe1033\cgrid\langnp1033\langfenp1033 {\lang2057\langfe1033\langnp2057\insrsid7218531 Attempt immediate delivery
\par }\pard\plain \ql \tx115\li115\ri130\sb80\widctlpar\aspalpha\aspnum\faauto\adjustright\rin130\txn115\lin115\itap0 \f1\fs16\lang1033\langfe1033\cgrid\langnp1033\langfenp1033 {\insrsid7218531 You can enter a list of domain masks (domain names, possibly containing wildcards, separated by commas) in this field.  When you click the button labeled  }{\b\f2\insrsid7218531 Reattempt delivery to these domains now}{\insrsid7218531 , any messages for foreign domains which match the domain mask list will be scheduled for an immediate delivery attempt.
\par By default, the field contains a single asterisk.  If you click the button, all messages for foreign domains will be scheduled for immediate retry.
\par Once you have clicked the button, the field is cleared.
\par }\pard\plain \s3\ql \tx115\li115\ri130\sb120\sa40\keepn\widctlpar\aspalpha\aspnum\faauto\outlinelevel2\adjustright\rin130\txn115\lin115\itap0\pararsid8130183 \b\i\f1\fs24\cf17\lang1033\langfe1033\cgrid\langnp1033\langfenp1033 {\insrsid7218531 \page }{\cs98\super\insrsid7218531 #{\footnote \pard\plain \s97\ql \tx115\li115\ri130\sb80\widctlpar\aspalpha\aspnum\faauto\adjustright\rin130\txn115\lin115\itap0 \f1\fs16\lang1033\langfe1033\cgrid\langnp1033\langfenp1033 {\cs98\super\insrsid15606814 #}{\insrsid15606814  ElapsedTimeSchedule}}${\footnote \pard\plain \s97\ql \tx115\li115\ri130\sb80\widctlpar\aspalpha\aspnum\faauto\adjustright\rin130\txn115\lin115\itap0 \f1\fs16\lang1033\langfe1033\cgrid\langnp1033\langfenp1033 {\cs98\super\insrsid15606814 $}{\insrsid15606814  Elapsed Time Schedule}}K{\footnote \pard\plain \s97\ql \tx115\li115\ri130\sb80\widctlpar\aspalpha\aspnum\faauto\adjustright\rin130\txn115\lin115\itap0 \f1\fs16\lang1033\langfe1033\cgrid\langnp1033\langfenp1033 {\cs98\super\insrsid15606814 K}{\insrsid15606814  Elapsed Time Schedule}}+{\footnote \pard\plain \s97\ql \tx115\li115\ri130\sb80\widctlpar\aspalpha\aspnum\faauto\adjustright\rin130\txn115\lin115\itap0 \f1\fs16\lang1033\langfe1033\cgrid\langnp1033\langfenp1033 {\cs98\super\insrsid15606814 +}{\insrsid15606814  mailsite:0000}}}{\insrsid7218531  Elapsed Time Schedule }{\cs98\super\insrsid7218531 K{\footnote \pard\plain \s97\ql \tx115\li115\ri130\sb80\widctlpar\aspalpha\aspnum\faauto\adjustright\rin130\txn115\lin115\itap0 \f1\fs16\lang1033\langfe1033\cgrid\langnp1033\langfenp1033 {\cs98\super\insrsid15606814 K}{\insrsid15606814  Elapsed Time Schedule}}}{\insrsid7218531 
\par }\pard\plain \ql \tx115\li115\ri130\sb80\widctlpar\aspalpha\aspnum\faauto\adjustright\rin130\txn115\lin115\itap0 \f1\fs16\lang1033\langfe1033\cgrid\langnp1033\langfenp1033 {\insrsid7218531 The elapsed time delivery schedule can be configured through this dialog:
\par }{\pard\plain \ql \tx115\li115\ri130\sb80\widctlpar\aspalpha\aspnum\faauto\adjustright\rin130\txn115\lin115\itap0 \f1\fs16\lang1024\langfe1024\cgrid\noproof\langnp1033\langfenp1033\insrsid6780023 \{bmc windows console - schedules - elapsed time - 256c.bmp\}}{\lang1024\langfe1024\noproof\insrsid6780023  }{\insrsid7218531\charrsid6780023 
\par }{\insrsid7218531 The elapsed time schedule is a list of times (measured in minutes from the time the first attempt is made) at which }{\insrsid13722995 WorldMail}{\insrsid7218531  will attempt to send remote messages.  By default, the pattern begins: 10, 10, 100, 10, 10, 100.  This means that if the first attempt fails, }{\insrsid13722995 WorldMail}{\insrsid7218531  will wait for ten minutes before the second attempt, and a further ten minutes before the third attempt.  It will then wait 100 minutes before the fourth attempt (which will therefore be made two hours after the first attempt), and so on.
\par At certain points in this delivery schedule, }{\insrsid13722995 WorldMail}{\insrsid7218531  will return a message delayed warning to the originators of the messages for the domain in question.  The Elapsed Time Schedule contains information about when such warning messages will be generated.
\par If delivery to a domain has been attempted without success so often that the end of the delivery schedule is reached, then messages for that domain are treated as undeliverable.
\par To add a delivery attempt to the Elapsed Time Delivery schedule, enter a time (in the form of a number followed by d, h or m for days, hours or minutes) and click the }{\b\f2\insrsid7218531 Add}{\insrsid7218531  button.
\par To request a warning message to be generated if a particular delivery attempt fails, check the checkbox beside the delivery attempt.
\par To delete a delivery attempt from the schedule, select it and click the }{\b\f2\insrsid7218531 Delete}{\insrsid7218531  button.
\par To revert to the default elapsed time delivery schedule, click the }{\b\f2\insrsid7218531 Default schedule}{\insrsid7218531  button.
\par }\pard\plain \s3\ql \tx115\li115\ri130\sb120\sa40\keepn\widctlpar\aspalpha\aspnum\faauto\outlinelevel2\adjustright\rin130\txn115\lin115\itap0\pararsid8130183 \b\i\f1\fs24\cf17\lang1033\langfe1033\cgrid\langnp1033\langfenp1033 {\insrsid7218531 \page }{\cs98\super\insrsid7218531 #{\footnote \pard\plain \s97\ql \tx115\li115\ri130\sb80\widctlpar\aspalpha\aspnum\faauto\adjustright\rin130\txn115\lin115\itap0 \f1\fs16\lang1033\langfe1033\cgrid\langnp1033\langfenp1033 {\cs98\super\insrsid15606814 #}{\insrsid15606814  TimeofDaySchedule}}${\footnote \pard\plain \s97\ql \tx115\li115\ri130\sb80\widctlpar\aspalpha\aspnum\faauto\adjustright\rin130\txn115\lin115\itap0 \f1\fs16\lang1033\langfe1033\cgrid\langnp1033\langfenp1033 {\cs98\super\insrsid15606814 $}{\insrsid15606814  Time-of-Day Schedule and Dialup Configuration}}K{\footnote \pard\plain \s97\ql \tx115\li115\ri130\sb80\widctlpar\aspalpha\aspnum\faauto\adjustright\rin130\txn115\lin115\itap0 \f1\fs16\lang1033\langfe1033\cgrid\langnp1033\langfenp1033 {\cs98\super\insrsid15606814 K}{\insrsid15606814  Time-of-Day Schedule and Dialup Configuration}}+{\footnote \pard\plain \s97\ql \tx115\li115\ri130\sb80\widctlpar\aspalpha\aspnum\faauto\adjustright\rin130\txn115\lin115\itap0 \f1\fs16\lang1033\langfe1033\cgrid\langnp1033\langfenp1033 {\cs98\super\insrsid15606814 +}{\insrsid15606814  mailsite:0000}}}{\insrsid7218531  Time-of-Day Schedule and Dialup Configuration }{\cs98\super\insrsid7218531 K{\footnote \pard\plain \s97\ql \tx115\li115\ri130\sb80\widctlpar\aspalpha\aspnum\faauto\adjustright\rin130\txn115\lin115\itap0 \f1\fs16\lang1033\langfe1033\cgrid\langnp1033\langfenp1033 {\cs98\super\insrsid15606814 K}{\insrsid15606814  Time of Day Schedule}}}{\insrsid7218531 
\par }\pard\plain \ql \tx115\li115\ri130\sb80\widctlpar\aspalpha\aspnum\faauto\adjustright\rin130\txn115\lin115\itap0 \f1\fs16\lang1033\langfe1033\cgrid\langnp1033\langfenp1033 {\insrsid7218531 The Time-of-Day Delivery Schedule dialog lets you configure the time-of-day delivery options and control the dialup features of }{\insrsid13722995 WorldMail}{\insrsid7218531 .
\par }{\pard\plain \ql \tx115\li115\ri130\sb80\widctlpar\aspalpha\aspnum\faauto\adjustright\rin130\txn115\lin115\itap0 \f1\fs16\lang1024\langfe1024\cgrid\noproof\langnp1033\langfenp1033\insrsid6780023 \{bmc windows console - schedules - delivery - 256c.bmp\}}{\lang1024\langfe1024\noproof\insrsid6780023  }{\insrsid7218531\charrsid6780023 
\par }\pard\plain \s4\ql \tx115\li115\ri130\sb80\widctlpar\aspalpha\aspnum\faauto\outlinelevel3\adjustright\rin130\txn115\lin115\itap0 \b\f2\fs16\ul\lang1033\langfe1033\cgrid\langnp1033\langfenp1033 {\insrsid7218531 Delivery Schedule
\par }\pard\plain \ql \tx115\li115\ri130\sb80\widctlpar\aspalpha\aspnum\faauto\adjustright\rin130\txn115\lin115\itap0 \f1\fs16\lang1033\langfe1033\cgrid\langnp1033\langfenp1033 {\insrsid7218531 The time-of-day schedule consists of a list of times of the day at which delivery will be attempted.  A different list of times pertains on weekdays and weekends.
\par You can specify the maximum number of times that message delivery will be attempted before a message is treated as undeliverable.
\par }\pard\plain \s4\ql \tx115\li115\ri130\sb80\widctlpar\aspalpha\aspnum\faauto\outlinelevel3\adjustright\rin130\txn115\lin115\itap0 \b\f2\fs16\ul\lang1033\langfe1033\cgrid\langnp1033\langfenp1033 {\insrsid7218531 Delivery Retry Limit
\par }\pard\plain \ql \tx115\li115\ri130\sb80\widctlpar\aspalpha\aspnum\faauto\adjustright\rin130\txn115\lin115\itap0 \f1\fs16\lang1033\langfe1033\cgrid\langnp1033\langfenp1033 {\insrsid7218531 A delivery attempt for each outstanding mail domain (other than domains in the }{\b\f2\insrsid7218531 Exclude Domains}{\insrsid7218531  field) will be made every time a dialup connection is established. If the delivery attempt is unsuccessful (for example, if the remote mail server is down or inaccessible at the scheduled dialup time), }{\insrsid13722995 WorldMail}{\insrsid7218531  will retain the message and retry later. However, if the number of delivery attempts exceeds a preset limit, delivery will be abandoned and a non-delivery notification will be generated. This field sets the limit for the number of attempts. The default value is 20.
\par }\pard\plain \s4\ql \tx115\li115\ri130\sb80\widctlpar\aspalpha\aspnum\faauto\outlinelevel3\adjustright\rin130\txn115\lin115\itap0 \b\f2\fs16\ul\lang1033\langfe1033\cgrid\langnp1033\langfenp1033 {\lang2057\langfe1033\langnp2057\insrsid7218531 Incoming Delivery trigger command
\par }\pard\plain \ql \tx115\li115\ri130\sb80\widctlpar\aspalpha\aspnum\faauto\adjustright\rin130\txn115\lin115\itap0 \f1\fs16\lang1033\langfe1033\cgrid\langnp1033\langfenp1033 {\insrsid7218531 When it is time for a delivery attempt to be made, before doing anything else, }{\insrsid13722995 WorldMail}{\insrsid7218531  will execute the }{\b\f2\insrsid7218531 Delivery Trigger Command}{\insrsid7218531 .  This can be any command you specify, but often it will be either the }{\b\f2\insrsid7218531 MSSTART}{\insrsid7218531  or the }{\b\f2\insrsid7218531 MSPOP}{\insrsid7218531  command, which can be used to request your Internet Service Provider's mail server to deliver queued messages to }{\insrsid13722995 WorldMail}{\insrsid7218531 .
\par Once connected to your ISP it is often necessary to take some action to cause your ISP's mail server to start sending your mail.  For instance, some ISP's let you use a }{\b\f2\insrsid7218531 finger}{\insrsid7218531  command.  Others (such as }{\insrsid13722995 WorldMail}{\insrsid7218531  itself) will respond to an }{\b\f2\insrsid7218531 ETRN}{\insrsid7218531  SMTP command. If your ISP's mail server needs prompting in this way, check this box and type in the command line to execute. The command line can either invoke a program or a batch file.  You must specify the full path.
\par If your ISP's mail server understands the }{\b\f2\insrsid7218531 ETRN}{\insrsid7218531  command, you could use the }{\b\f2\insrsid7218531 MSSTART}{\insrsid7218531  command to trigger delivery of queued mail for your domain:
\par {\pard\plain\f3\fs18\insrsid7218531 \loch\af3\dbch\af0\hich\f3 \'de\fi-720\li115\tx115 \tab}{\*\pntextbsx\pard\plain\f3\fs18\insrsid7218531 \loch\af3\dbch\af0\hich\f3 \'de\tab}}\pard \ql \fi-720\tx1080\li1080\ri130\sb80\widctlpar\jclisttab{\*\pnbsx \pnlvlblt\ilvl0\ls61\pnrnot0\pnf3\pnstart1\pnindent360\pnsp120\pnhang {\pntxtb \'de}}\tx1080 \aspalpha\aspnum\faauto\ls61\adjustright\rin130\txn1080\lin1080\itap0 {\b\f2\fs18\insrsid7218531 C:\\}{\b\f2\fs18\insrsid6317884 Program Files\\}{\b\f2\fs18\insrsid2231627 QUALCOMM\\WorldMail}{\b\f2\fs18\insrsid6317884 \\}{\b\f2\fs18\insrsid7218531 msstart -h mailserver.isp.com myco.com
\par }\pard \ql \tx115\li115\ri130\sb80\widctlpar\aspalpha\aspnum\faauto\adjustright\rin130\txn115\lin115\itap0 {\insrsid7218531 This tells the mail server to start sending mail for }{\b\f2\insrsid7218531 myco.com}{\insrsid7218531 .
\par Alternatively, your ISP may accumulate mail for you in a mailbox, and expect you to download it using POP. The }{\b\f2\insrsid7218531 MSPOP}{\insrsid7218531  utility will help in this situation. }{\b\f2\insrsid7218531 MSPOP}{\insrsid7218531  will retrieve mail from the mailbox at your ISP and will redirect it to recipients on your local system. You might type in the following trigger command line:
\par {\pard\plain\f3\fs18\insrsid7218531 \loch\af3\dbch\af0\hich\f3 \'de\fi-720\li1080\tx1080 \tab}{\*\pntextbsx\pard\plain\f3\fs18\insrsid7218531 \loch\af3\dbch\af0\hich\f3 \'de\tab}}\pard \ql \fi-720\tx1080\li1080\ri130\sb80\widctlpar\jclisttab{\*\pnbsx \pnlvlblt\ilvl0\ls62\pnrnot0\pnf3\pnstart1\pnindent360\pnsp120\pnhang {\pntxtb \'de}}\tx1080 \aspalpha\aspnum\faauto\ls62\adjustright\rin130\txn1080\lin1080\itap0 {\b\f2\fs18\insrsid7218531 C:\\}{\b\f2\fs18\insrsid6317884 Program Files\\}{\b\f2\fs18\insrsid2231627 QUALCOMM\\WorldMail}{\b\f2\fs18\insrsid6317884 \\}{\b\f2\fs18\insrsid7218531 mspop -h mailserver.isp.com -u myusername -p mypassword
\par }\pard \ql \tx115\li115\ri130\sb80\widctlpar\aspalpha\aspnum\faauto\adjustright\rin130\txn115\lin115\itap0 {\insrsid7218531 Note that when calculating the duration of the dialup connection, }{\insrsid13722995 WorldMail}{\insrsid7218531  will not start counting until the Delivery Trigger Command (if it exists) has finished. Thus, a command that does not terminate could cause the dialup connection to stay open indefinitely.
\par See the section on }{\uldb\insrsid7218531 Intermittent Connectivity}{\v\uldb\insrsid7218531 IntermittentConnectivity}{\insrsid7218531  for more information.
{\v0\par\v}See the }{\uldb\insrsid7218531 Appendix}{\v\uldb\insrsid7218531 Utilities}{\insrsid7218531  for the full }{\b\f2\insrsid7218531 MSPOP}{\insrsid7218531  and }{\b\f2\insrsid7218531 MSSTART}{\insrsid7218531  syntax.
{\v0\par\v}}\pard\plain \s4\ql \tx115\li115\ri130\sb80\widctlpar\aspalpha\aspnum\faauto\outlinelevel3\adjustright\rin130\txn115\lin115\itap0 \b\f2\fs16\ul\lang1033\langfe1033\cgrid\langnp1033\langfenp1033 {\insrsid7218531 Dialup Server
\par }\pard\plain \ql \tx115\li115\ri130\sb80\widctlpar\aspalpha\aspnum\faauto\adjustright\rin130\txn115\lin115\itap0 \f1\fs16\lang1033\langfe1033\cgrid\langnp1033\langfenp1033 {\cs98\super\insrsid7218531 K{\footnote \pard\plain \s97\ql \tx115\li115\ri130\sb80\widctlpar\aspalpha\aspnum\faauto\adjustright\rin130\txn115\lin115\itap0 \f1\fs16\lang1033\langfe1033\cgrid\langnp1033\langfenp1033 {\cs98\super\insrsid15606814 K}{\insrsid15606814  Dialup connectivity}}}{\insrsid13722995 WorldMail}{\insrsid7218531  supports dialup connectivity to the Internet through the Microsoft Remote Access Service (RAS). This allows a computer running }{\insrsid13722995 WorldMail}{\insrsid7218531  to dial into an Internet Service Provider (ISP) to exchange mail on a predetermined schedule. 
\par In order to use the }{\insrsid13722995 WorldMail}{\insrsid7218531  dialup support, you must install RAS on the computer running }{\insrsid13722995 WorldMail}{\insrsid7218531 . See the Microsoft documentation concerning RAS installation. You will need to create at least one RAS phonebook entry, containing the phone number of your ISP. Before configuring the dialup support in }{\insrsid13722995 WorldMail}{\insrsid7218531 , check the basic RAS setup by dialing out to your ISP using the "Dialup Networking" tool provided with RAS. If this does not work, }{\insrsid13722995 WorldMail}{\insrsid7218531  will not be able to dial out. 
\par If you enable dialup, then your }{\insrsid13722995 WorldMail}{\insrsid7218531  server will dial the phonebook entry according to the schedule that you define.  Once connected, it will send any queued outgoing mail and will initiate delivery of incoming mail using the }{\b\f2\insrsid7218531 Incoming Delivery Trigger Command}{\insrsid7218531 .
\par When there is no more outgoing mail to send, and there are no incoming connections to }{\insrsid13722995 WorldMail}{\insrsid7218531 , the dialup connection will be closed and the phone line hung up.
\par The Dialup Server part of the Time of Day Schedule dialog contains the following controls:
\par }\pard\plain \s4\ql \tx115\li115\ri130\sb80\widctlpar\aspalpha\aspnum\faauto\outlinelevel3\adjustright\rin130\txn115\lin115\itap0 \b\f2\fs16\ul\lang1033\langfe1033\cgrid\langnp1033\langfenp1033 {\insrsid7218531 Enable dialup
\par }\pard\plain \ql \tx115\li115\ri130\sb80\widctlpar\aspalpha\aspnum\faauto\adjustright\rin130\txn115\lin115\itap0 \f1\fs16\lang1033\langfe1033\cgrid\langnp1033\langfenp1033 {\insrsid7218531 Check this box to turn on dialup support in }{\insrsid13722995 WorldMail}{\insrsid7218531 . Dialup support is disabled by default.
\par }\pard\plain \s4\ql \tx115\li115\ri130\sb80\widctlpar\aspalpha\aspnum\faauto\outlinelevel3\adjustright\rin130\txn115\lin115\itap0 \b\f2\fs16\ul\lang1033\langfe1033\cgrid\langnp1033\langfenp1033 {\insrsid7218531 Phonebook Entry
\par }\pard\plain \ql \tx115\li115\ri130\sb80\widctlpar\aspalpha\aspnum\faauto\adjustright\rin130\txn115\lin115\itap0 \f1\fs16\lang1033\langfe1033\cgrid\langnp1033\langfenp1033 {\insrsid7218531 Select an entry from the RAS phonebook that corresponds with your ISP's service. You can use the }{\b\f2\insrsid7218531 Edit}{\insrsid7218531  button on the right to edit the phonebook entry.
\par }\pard\plain \s4\ql \tx115\li115\ri130\sb80\widctlpar\aspalpha\aspnum\faauto\outlinelevel3\adjustright\rin130\txn115\lin115\itap0 \b\f2\fs16\ul\lang1033\langfe1033\cgrid\langnp1033\langfenp1033 {\insrsid7218531 User name
\par }\pard\plain \ql \tx115\li115\ri130\sb80\widctlpar\aspalpha\aspnum\faauto\adjustright\rin130\txn115\lin115\itap0 \f1\fs16\lang1033\langfe1033\cgrid\langnp1033\langfenp1033 {\insrsid7218531 Your ISP will have given you a username and password to give you access to the dialup server. Type the username here. If the ISP is running a RAS server, you may be given a Microsoft domain name as well.  For example, if the domain name is }{\b\f2\insrsid7218531 ISPDOM}{\insrsid7218531 , you should add this prefix to your username, as in }{\b\f2\insrsid7218531 ISPDOM\\username}{\insrsid7218531 .
\par }\pard\plain \s4\ql \tx115\li115\ri130\sb80\widctlpar\aspalpha\aspnum\faauto\outlinelevel3\adjustright\rin130\txn115\lin115\itap0 \b\f2\fs16\ul\lang1033\langfe1033\cgrid\langnp1033\langfenp1033 {\insrsid7218531 Password
\par }\pard\plain \ql \tx115\li115\ri130\sb80\widctlpar\aspalpha\aspnum\faauto\adjustright\rin130\txn115\lin115\itap0 \f1\fs16\lang1033\langfe1033\cgrid\langnp1033\langfenp1033 {\insrsid7218531 Type in your ISP password here.
\par }\pard\plain \s4\ql \tx115\li115\ri130\sb80\widctlpar\aspalpha\aspnum\faauto\outlinelevel3\adjustright\rin130\txn115\lin115\itap0 \b\f2\fs16\ul\lang1033\langfe1033\cgrid\langnp1033\langfenp1033 {\insrsid7218531 Pause after connecting
\par }\pard\plain \ql \tx115\li115\ri130\sb80\widctlpar\aspalpha\aspnum\faauto\adjustright\rin130\txn115\lin115\itap0 \f1\fs16\lang1033\langfe1033\cgrid\langnp1033\langfenp1033 {\insrsid7218531 With some Internet Service Providers you have to wait for a short time (for example, 15 seconds) after you connect to their service before the connection becomes fully functional.  Usually, this is to allow the ISP to update routing information.  You can specify a time in to wait using this field.}{\insrsid7218531 
\par }\pard\plain \s4\ql \tx115\li115\ri130\sb80\widctlpar\aspalpha\aspnum\faauto\outlinelevel3\adjustright\rin130\txn115\lin115\itap0 \b\f2\fs16\ul\lang1033\langfe1033\cgrid\langnp1033\langfenp1033 {\insrsid7218531 Dialup connection time
\par }\pard\plain \ql \tx115\li115\ri130\sb80\widctlpar\aspalpha\aspnum\faauto\adjustright\rin130\txn115\lin115\itap0 \f1\fs16\lang1033\langfe1033\cgrid\langnp1033\langfenp1033 {\insrsid7218531 You can specify (in minutes) the maximum time for which a dialup connection will remain open. }{\insrsid13722995 WorldMail}{\insrsid7218531  will close the connection after this time, even though the connection may be in use for sending and receiving mail. The default is 30 minutes. You can also specify a minimum time that the connection will remain open--}{\insrsid13722995 WorldMail}{\insrsid7218531  will not close the dialup connection before this time, even if it is not being used for mail. If you reduce this too far, your ISP's mail server may not have enough time to establish an SMTP connection to you. The default is 2 minutes. (Note that both these times are approximate--the actual time may be longer by up to two minutes.)
\par Note that when calculating the duration of the dialup connection, }{\insrsid13722995 WorldMail}{\insrsid7218531  will not start counting until the delivery trigger command (if there is one) has finished. Thus, a command that does not terminate could cause the dialup connection to stay open indefinitely. 
\par }\pard\plain \s4\ql \tx115\li115\ri130\sb80\widctlpar\aspalpha\aspnum\faauto\outlinelevel3\adjustright\rin130\txn115\lin115\itap0 \b\f2\fs16\ul\lang1033\langfe1033\cgrid\langnp1033\langfenp1033 {\insrsid7218531 Dialup Status and Controls
\par }\pard\plain \ql \tx115\li115\ri130\sb80\widctlpar\aspalpha\aspnum\faauto\adjustright\rin130\txn115\lin115\itap0 \f1\fs16\lang1033\langfe1033\cgrid\langnp1033\langfenp1033 {\insrsid7218531 These fields show the status of the dialup connection. If no connection is in progress, it will show the time of the next scheduled connection, otherwise it will show }{\b\f2\insrsid7218531 Connecting}{\insrsid7218531 , }{\b\f2\insrsid7218531 Connected}{\insrsid7218531  or }{\b\f2\insrsid7218531 Disconnecting.}{\insrsid7218531 
\par If there is no connection in progress, you can request an immediate dialup using the }{\b\f2\insrsid7218531 Dialup Now!}{\insrsid7218531  button. In the }{\b\f2\insrsid7218531 Connected}{\insrsid7218531  state, you may terminate the connection using the }{\b\f2\insrsid7218531 Hang up!}{\insrsid7218531  button.
\par These buttons are useful for testing and debugging your dialup configuration.
\par }\pard\plain \s3\ql \tx115\li115\ri130\sb120\sa40\keepn\widctlpar\aspalpha\aspnum\faauto\outlinelevel2\adjustright\rin130\txn115\lin115\itap0\pararsid8130183 \b\i\f1\fs24\cf17\lang1033\langfe1033\cgrid\langnp1033\langfenp1033 {\lang2057\langfe1033\langnp2057\insrsid7218531 \page }{\cs98\lang2057\langfe1033\super\langnp2057\insrsid7218531 #{\footnote \pard\plain \s97\ql \tx115\li115\ri130\sb80\widctlpar\aspalpha\aspnum\faauto\adjustright\rin130\txn115\lin115\itap0 \f1\fs16\lang1033\langfe1033\cgrid\langnp1033\langfenp1033 {\cs98\super\insrsid15606814 #}{\insrsid15606814  WeekdayandWeekendSchedule}}${\footnote \pard\plain \s97\ql \tx115\li115\ri130\sb80\widctlpar\aspalpha\aspnum\faauto\adjustright\rin130\txn115\lin115\itap0 \f1\fs16\lang1033\langfe1033\cgrid\langnp1033\langfenp1033 {\cs98\super\insrsid15606814 $}{\insrsid15606814  Weekday and Weekend schedules}}K{\footnote \pard\plain \s97\ql \tx115\li115\ri130\sb80\widctlpar\aspalpha\aspnum\faauto\adjustright\rin130\txn115\lin115\itap0 \f1\fs16\lang1033\langfe1033\cgrid\langnp1033\langfenp1033 {\cs98\super\insrsid15606814 K}{\insrsid15606814  Weekday and Weekend schedules}}+{\footnote \pard\plain \s97\ql \tx115\li115\ri130\sb80\widctlpar\aspalpha\aspnum\faauto\adjustright\rin130\txn115\lin115\itap0 \f1\fs16\lang1033\langfe1033\cgrid\langnp1033\langfenp1033 {\cs98\super\insrsid15606814 +}{\insrsid15606814  mailsite:0000}}}{\lang2057\langfe1033\langnp2057\insrsid7218531  Weekday and Weekend schedules }{\cs98\lang2057\langfe1033\super\langnp2057\insrsid7218531 K{\footnote \pard\plain \s97\ql \tx115\li115\ri130\sb80\widctlpar\aspalpha\aspnum\faauto\adjustright\rin130\txn115\lin115\itap0 \f1\fs16\lang1033\langfe1033\cgrid\langnp1033\langfenp1033 {\cs98\super\insrsid15606814 K}{\insrsid15606814  Weekday Delivery Schedule}}}{\lang2057\langfe1033\langnp2057\insrsid7218531  }{\cs98\lang2057\langfe1033\super\langnp2057\insrsid7218531 K{\footnote \pard\plain \s97\ql \tx115\li115\ri130\sb80\widctlpar\aspalpha\aspnum\faauto\adjustright\rin130\txn115\lin115\itap0 \f1\fs16\lang1033\langfe1033\cgrid\langnp1033\langfenp1033 {\cs98\super\insrsid15606814 K}{\insrsid15606814  Weekend Delivery Schedule}}}{\lang2057\langfe1033\langnp2057\insrsid7218531 
\par }\pard\plain \ql \tx115\li115\ri130\sb80\widctlpar\aspalpha\aspnum\faauto\adjustright\rin130\txn115\lin115\itap0 \f1\fs16\lang1033\langfe1033\cgrid\langnp1033\langfenp1033 {\insrsid7218531 To configure the weekday and weekend delivery schedules, click on the appropriate button.  You will see a dialog like this:
\par }{\pard\plain \ql \tx115\li115\ri130\sb80\widctlpar\aspalpha\aspnum\faauto\adjustright\rin130\txn115\lin115\itap0 \f1\fs16\lang1024\langfe1024\cgrid\noproof\langnp1033\langfenp1033\insrsid6780023 \{bmc windows console - schedules - weekday - 256c.bmp\}}{\lang1024\langfe1024\noproof\insrsid6780023  }{\insrsid7218531\charrsid6780023 
\par }{\insrsid7218531 Times for delivery attempts are given using the 24-hour clock.  To add a delivery time to the schedule, use the spin control to select a time, then click the }{\b\f2\insrsid7218531 Add}{\insrsid7218531  button.  To remove a time from the schedule, click on the time and then click the }{\b\f2\insrsid7218531 Remove}{\insrsid7218531  button.
\par To request a dialup even when there is no outgoing mail waiting to be delivered, place a checkmark beside the corresponding time.  (The checkmarks are irrelevant if dialup is not enabled.)
\par }\pard\plain \s2\ql \tx115\li115\ri130\sb120\sa40\keepn\widctlpar\aspalpha\aspnum\faauto\outlinelevel1\adjustright\rin130\txn115\lin115\itap0\pararsid8130183 \b\f1\fs28\cf17\lang1033\langfe1033\cgrid\langnp1033\langfenp1033 {\insrsid7218531 \page }{\cs98\super\insrsid7218531 #{\footnote \pard\plain \s97\ql \tx115\li115\ri130\sb80\widctlpar\aspalpha\aspnum\faauto\adjustright\rin130\txn115\lin115\itap0 \f1\fs16\lang1033\langfe1033\cgrid\langnp1033\langfenp1033 {\cs98\super\insrsid15606814 #}{\insrsid15606814  ServicesFolder}}${\footnote \pard\plain \s97\ql \tx115\li115\ri130\sb80\widctlpar\aspalpha\aspnum\faauto\adjustright\rin130\txn115\lin115\itap0 \f1\fs16\lang1033\langfe1033\cgrid\langnp1033\langfenp1033 {\cs98\super\insrsid15606814 $}{\insrsid15606814  Services Folder}}K{\footnote \pard\plain \s97\ql \tx115\li115\ri130\sb80\widctlpar\aspalpha\aspnum\faauto\adjustright\rin130\txn115\lin115\itap0 \f1\fs16\lang1033\langfe1033\cgrid\langnp1033\langfenp1033 {\cs98\super\insrsid15606814 K}{\insrsid15606814  Services Folder}}+{\footnote \pard\plain \s97\ql \tx115\li115\ri130\sb80\widctlpar\aspalpha\aspnum\faauto\adjustright\rin130\txn115\lin115\itap0 \f1\fs16\lang1033\langfe1033\cgrid\langnp1033\langfenp1033 {\cs98\super\insrsid15606814 +}{\insrsid15606814  mailsite:0000}}}{\insrsid7218531  Services
\par }\pard\plain \ql \tx115\li115\ri130\sb80\widctlpar\aspalpha\aspnum\faauto\adjustright\rin130\txn115\lin115\itap0 \f1\fs16\lang1033\langfe1033\cgrid\langnp1033\langfenp1033 {\cs98\super\insrsid7218531 K{\footnote \pard\plain \s97\ql \tx115\li115\ri130\sb80\widctlpar\aspalpha\aspnum\faauto\adjustright\rin130\txn115\lin115\itap0 \f1\fs16\lang1033\langfe1033\cgrid\langnp1033\langfenp1033 {\cs98\super\insrsid15606814 K}{\insrsid15606814  Services}}}{\insrsid7218531 If you are administering }{\insrsid13722995 WorldMail}{\insrsid7218531  on your local computer, or if you are administering }{\insrsid13722995 WorldMail}{\insrsid7218531  from another system, you will see a Services folder in the }{\insrsid14683656 Management Center}{\insrsid7218531 .  When you select this folder, the right-hand pane will display the installed }{\insrsid13722995 WorldMail}{\insrsid7218531  services:
\par }{\pard\plain \ql \tx115\li115\ri130\sb80\widctlpar\aspalpha\aspnum\faauto\adjustright\rin130\txn115\lin115\itap0 \f1\fs16\lang1024\langfe1024\cgrid\noproof\langnp1033\langfenp1033\insrsid6780023 \{bmc windows console - services - 256c.bmp\}}{\lang1024\langfe1024\noproof\insrsid6780023  }{\insrsid7218531\charrsid6780023 
\par }{\insrsid7218531 This form displays the current status of each }{\insrsid13722995 WorldMail}{\insrsid7218531  service.  The light bulb icon shows the state of each service.  To see the icons in a different format, choose one of the four leftmost buttons on the toolbar, or select the type of view you want from the View menu.  To refresh the right-hand pane, choose }{\b\f2\insrsid7218531 Refresh}{\insrsid7218531  from the View menu or click the }{\b\f2\insrsid7218531 Refresh}{\insrsid7218531  button (the one with the two arrows).
\par To start a service, select it and then choose the }{\b\f2\insrsid7218531 Start}{\insrsid7218531  option from the Service menu.  Alternatively, you can use the corresponding toolbar button, or you can right-click on the icon and select }{\b\f2\insrsid7218531 Start}{\insrsid7218531  from the popup menu.  Stopping services works the same way by selecting }{\b\f2\insrsid7218531 Stop}{\insrsid7218531  from these menus. By selecting multiple icons, you can stop and start more than one service.
\par Stopping the SMTP Receiver Service will prevent }{\insrsid13722995 WorldMail}{\insrsid7218531  from receiving mail.  Stopping the SMTP Delivery Service will prevent }{\insrsid13722995 WorldMail}{\insrsid7218531  from sending mail. Stopping the POP3 Service will prevent users from receiving any new mail. Stopping the IMAP4 Service will prevent users from accessing their mailbox. Stopping the HTTP Management Service will prevent users from configuring their mailboxes from their Web browser. Stopping the MAILMA service will prevent users from changing their password from their e-mail client and will disable remote }{\insrsid13722995 WorldMail}{\insrsid7218531  }{\insrsid14683656 Management Center}{\insrsid7218531  access. Stopping the LDAP3A service will stop }{\insrsid13722995 WorldMail}{\insrsid7218531  responding to directory searches.
\par }\pard\plain \s3\ql \tx115\li115\ri130\sb120\sa40\keepn\widctlpar\aspalpha\aspnum\faauto\outlinelevel2\adjustright\rin130\txn115\lin115\itap0\pararsid8130183 \b\i\f1\fs24\cf17\lang1033\langfe1033\cgrid\langnp1033\langfenp1033 {\insrsid7218531 \page }{\cs98\super\insrsid7218531 #{\footnote \pard\plain \s97\ql \tx115\li115\ri130\sb80\widctlpar\aspalpha\aspnum\faauto\adjustright\rin130\txn115\lin115\itap0 \f1\fs16\lang1033\langfe1033\cgrid\langnp1033\langfenp1033 {\cs98\super\insrsid15606814 #}{\insrsid15606814  ServiceProperties}}${\footnote \pard\plain \s97\ql \tx115\li115\ri130\sb80\widctlpar\aspalpha\aspnum\faauto\adjustright\rin130\txn115\lin115\itap0 \f1\fs16\lang1033\langfe1033\cgrid\langnp1033\langfenp1033 {\cs98\super\insrsid15606814 $}{\insrsid15606814  Service Properties}}K{\footnote \pard\plain \s97\ql \tx115\li115\ri130\sb80\widctlpar\aspalpha\aspnum\faauto\adjustright\rin130\txn115\lin115\itap0 \f1\fs16\lang1033\langfe1033\cgrid\langnp1033\langfenp1033 {\cs98\super\insrsid15606814 K}{\insrsid15606814  Service Properties}}+{\footnote \pard\plain \s97\ql \tx115\li115\ri130\sb80\widctlpar\aspalpha\aspnum\faauto\adjustright\rin130\txn115\lin115\itap0 \f1\fs16\lang1033\langfe1033\cgrid\langnp1033\langfenp1033 {\cs98\super\insrsid15606814 +}{\insrsid15606814  mailsite:0000}}}{\insrsid7218531  Service Properties
\par }\pard\plain \ql \tx115\li115\ri130\sb80\widctlpar\aspalpha\aspnum\faauto\adjustright\rin130\txn115\lin115\itap0 \f1\fs16\lang1033\langfe1033\cgrid\langnp1033\langfenp1033 {\insrsid7218531 Most of the services listen on a TCP/IP Port.  You can configure this Port by selecting }{\b\f2\insrsid7218531 Service}{\insrsid7218531  and }{\b\f2\insrsid7218531 Port}{\insrsid7218531  from the menu.  The following form will be displayed:
