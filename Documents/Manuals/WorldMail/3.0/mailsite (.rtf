\i domain}{] -loginpass }{\i password}{ ...\line msbox -list [}{\i domain}{]\line msbox -list2 [}{\i domain}{] -security }{\i pass}{\line msbox -create }{\i name}{[@}{\i domain}{] }{\i pluginid}{\line msbox -delete }{\i name}{[@}{\i domain}{]\line 
msbox -set }{\i name}{[@}{\i domain}{] }{\i property}{ }{\i value}{\line msbox -get }{\i name}{[@}{\i domain}{] }{\i property}{\line msbox -pass }{\i name}{[@}{\i domain}{] [Plaintextpassword]\line msbox -plugin }{\i name}{[@}{\i domain}{] }{\i pluginid
\line }{msbox -plugin @}{\i filename}{ }{\i pluginid\line }{msbox -createalias }{\i name}{[@}{\i domain}{] }{\i alias}{[@}{\i domain}{]\line msbox -deletealias }{\i alias}{[@}{\i domain}{]\line msbox -listalias }{\i name}{[@}{\i domain}{]
