{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "perl \"$CLAUDE_PROJECT_DIR/tools/sitzungsbeginn.pl\"",
            "timeout": 120,
            "statusMessage": "Lage zu Sitzungsbeginn: offene Befunde, faellige Rollen, Ungesichertes"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "perl \"$CLAUDE_PROJECT_DIR/tools/haken-pr-lektor.pl\"",
            "timeout": 60,
            "statusMessage": "Pruefe: ist der LEKTOR vor dem PR gelaufen?"
          }
        ]
      }
    ]
  }
}
