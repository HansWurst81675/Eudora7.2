  <!--
    Eigenstaendiges Testprojekt. Es gehoert bewusst NICHT zur Eudora-Solution und
    fasst weder Eudora.vcxproj noch sonst eine bestehende Datei an. Gebaut wird mit

      MSBuild.exe Eudora71\Tests\Tests.vcxproj /p:Configuration=Debug /p:Platform=Win32
  -->
  <ItemGroup Label="ProjectConfigurations">
    <ProjectConfiguration Include="Debug|Win32">
      <Configuration>Debug</Configuration>
      <Platform>Win32</Platform>
    </ProjectConfiguration>
  </ItemGroup>
  <PropertyGroup Label="Globals">
    <ProjectGuid>{7E5D1A20-9C41-4F86-B0D3-2A6E7C914B01}</ProjectGuid>
    <RootNamespace>EudoraTests</RootNamespace>
    <Keyword>MFCProj</Keyword>
  </PropertyGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.Default.props" />
  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|Win32'" Label="Configuration">
    <ConfigurationType>Application</ConfigurationType>
    <UseDebugLibraries>true</UseDebugLibraries>
    <PlatformToolset>v143</PlatformToolset>
    <!-- Wie Eudora selbst: MFC als DLL, MBCS. CString ist damit dasselbe CStringA
         wie im Produktivcode. -->
    <UseOfMfc>Dynamic</UseOfMfc>
    <CharacterSet>MultiByte</CharacterSet>
  </PropertyGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.props" />
  <PropertyGroup>
    <OutDir>$(MSBuildProjectDirectory)\Build\$(Configuration)\</OutDir>
    <IntDir>$(MSBuildProjectDirectory)\Build\$(Configuration)\obj\</IntDir>
    <TargetName>EudoraTests</TargetName>
    <EudoraSrcDir>$(MSBuildProjectDirectory)\..\Eudora</EudoraSrcDir>
    <GeneratedDir>$(MSBuildProjectDirectory)\generated</GeneratedDir>
  </PropertyGroup>
  <ItemDefinitionGroup>
    <ClCompile>
      <WarningLevel>Level3</WarningLevel>
      <Optimization>Disabled</Optimization>
      <RuntimeLibrary>MultiThreadedDebugDLL</RuntimeLibrary>
      <PreprocessorDefinitions>WIN32;_DEBUG;_CONSOLE;_CRT_SECURE_NO_WARNINGS;_CRT_NONSTDC_NO_WARNINGS;NOEXPRLOG;BUGSUTIL_DLLINTERFACE=;%(PreprocessorDefinitions)</PreprocessorDefinitions>
      <AdditionalIncludeDirectories>$(MSBuildProjectDirectory);$(MSBuildProjectDirectory)\..\OTShim;$(MSBuildProjectDirectory)\..\OT501\Include;$(MSBuildProjectDirectory)\..\QCUtils\public\inc;$(MSBuildProjectDirectory)\..\EuMemMgr\Include;%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
      <!-- Die Quelldateien von Eudora sind in CP1252 abgelegt (Zeichenliterale wie
           (UCHAR)'<80>' in der Uebersetzungstabelle). Beide Zeichensaetze werden
           deshalb ausdruecklich festgelegt, damit der Build nicht von der
           Systemcodepage abhaengt. -->
      <AdditionalOptions>/source-charset:.1252 /execution-charset:.1252 %(AdditionalOptions)</AdditionalOptions>
      <DebugInformationFormat>ProgramDatabase</DebugInformationFormat>
      <MultiProcessorCompilation>true</MultiProcessorCompilation>
    </ClCompile>
    <Link>
      <SubSystem>Console</SubSystem>
      <!-- Dasselbe ComCtl32 wie Eudora selbst (Eudora71\Eudora\Eudora.manifest).
           Ohne diese Abhaengigkeit bindet das Testprogramm die Fassung 5.82,
           und comctl32!CreateMappedBitmap stuerzt dort bei einer Bitmap mit
           mehr als 8 Bit Farbtiefe ab (gemessen, siehe Befunde/SYMBOLE.md).
           Geprueft werden soll das Verhalten, das Eudora tatsaechlich sieht. -->
      <AdditionalManifestDependencies>type='win32' name='Microsoft.Windows.Common-Controls' version='6.0.0.0' processorArchitecture='*' publicKeyToken='6595b64144ccf1df' language='*'</AdditionalManifestDependencies>
      <GenerateDebugInformation>true</GenerateDebugInformation>
    </Link>
  </ItemDefinitionGroup>
  <!-- Vor dem Uebersetzen den zu pruefenden Code frisch aus dem Produktivcode
       schneiden. Die Originaldateien werden dabei nur gelesen. -->
  <Target Name="ExtractCodeUnderTest" BeforeTargets="ClCompile">
    <Exec Command="powershell.exe -NoProfile -NonInteractive -ExecutionPolicy Bypass -File &quot;$(MSBuildProjectDirectory)\Extract.ps1&quot; -SrcDir &quot;$(EudoraSrcDir)&quot; -OutDir &quot;$(GeneratedDir)&quot;" />
